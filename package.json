{
  "name": "3d-mir",
  "version": "1.0.0-rc.61",
  "private": true,
  "description": "Webseite und 3D-Druck-Rechner für 3D-MIR 3D-Druck Service",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/server.ts",
    "build": "npm run fonts && npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json && cp -r src/db/migrations/. dist/db/migrations/",
    "build:web": "vite build",
    "fonts": "node scripts/prepare-fonts.mjs",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "orders:cleanup": "tsx scripts/cleanup-orders.ts",
    "mail:test": "tsx scripts/test-mail.ts",
    "monitor:check": "node dist/scripts/uptime-check.js",
    "uploads:cleanup": "node dist/scripts/cleanup-uploads.js",
    "etsy:import": "tsx scripts/import-etsy.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "argon2": "^0.41.1",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^5.12.0",
    "fastify": "^5.2.1",
    "fflate": "^0.8.3",
    "maxmind": "^5.1.0",
    "nodemailer": "^6.10.0",
    "nunjucks": "^3.2.4",
    "pdfkit": "^0.17.2",
    "pino": "^9.14.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "three": "^0.187.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "@types/nodemailer": "^6.4.17",
    "@types/nunjucks": "^3.2.6",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.187.0",
    "subset-font": "^2.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
