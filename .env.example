# Vorlage für die lokale Entwicklung. Kopieren nach `.env` (wird nicht committet).
# In Produktion liegt die Datei unter /etc/3d-mir/3d-mir.env (chmod 600).

NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Verzeichnisse (produktiv: /var/lib/3d-mir und /var/log/3d-mir)
DATA_DIR=/var/lib/3d-mir
LOG_DIR=/var/log/3d-mir

# Pflicht in Produktion: mindestens 32 zufällige Zeichen
# Erzeugen mit: openssl rand -base64 48
SESSION_SECRET=

# SMTP (leer = E-Mails werden als .eml in /var/log/3d-mir/mail/ abgelegt)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=3D-MIR <info@3d-mir.de>
MAIL_TO=info@3d-mir.de

# Upload-Limit in MB
MAX_UPLOAD_MB=50

# Zahlungen (Stripe). Geheimnisse niemals ins Repository schreiben.
# In Produktion unter /etc/3d-mir/3d-mir.env mit chmod 600 hinterlegen.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Öffentliche Basis-URL für Rückleitungen (Standard: site.baseUrl)
# Lokal z. B. http://127.0.0.1:3000, produktiv https://www.3d-mir.de
PAYMENT_BASE_URL=
