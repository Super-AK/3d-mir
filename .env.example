# Vorlage für die lokale Entwicklung. Kopieren nach `.env` (wird nicht committet).
# In Produktion liegt die Datei unter /etc/3d-mir/3d-mir.env (chmod 600).

NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Verzeichnisse (produktiv: /var/lib/3d-mir und /var/log/3d-mir)
DATA_DIR=/var/lib/3d-mir
LOG_DIR=/var/log/3d-mir

# Pflicht in Produktion: mindestens 32 zufällige Zeichen
# Erzeugen mit: openssl rand -base64 48
SESSION_SECRET=

# Nur Anfragen von diesen Proxies dürfen X-Forwarded-For und Länder-Header setzen.
TRUST_PROXY=127.0.0.1

# Lokale GeoIP-Datenbank für die Länderprüfung des Kontaktformulars.
# Installieren/aktualisieren mit: sudo deploy/update-geoip.sh
# Standard: $DATA_DIR/geoip/dbip-country-lite.mmdb
GEOIP_DB_PATH=

# Optional: Länder-Header eines vorgeschalteten CDN (z. B. cf-ipcountry).
# Leer lassen, wenn kein CDN genutzt wird; sonst könnte der Header gefälscht werden.
COUNTRY_HEADER=

# SMTP (leer = E-Mails werden als .eml in /var/log/3d-mir/mail/ abgelegt)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=3D-MIR <info@3d-mir.de>
MAIL_TO=info@3d-mir.de

# Upload-Limit in MB
MAX_UPLOAD_MB=50

# Zahlungen (Stripe). Geheimnisse niemals ins Repository schreiben.
# In Produktion unter /etc/3d-mir/3d-mir.env mit chmod 600 hinterlegen.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Öffentliche Basis-URL für Rückleitungen (Standard: site.baseUrl)
# Lokal z. B. http://127.0.0.1:3000, produktiv https://www.3d-mir.de
PAYMENT_BASE_URL=

# Admin-Benachrichtigungen (können auch im Admin unter „Benachrichtigungen“ gepflegt werden)
# mail | telegram | both
NOTIFICATION_CHANNEL=mail
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Passkeys (WebAuthn). Leer = automatisch Domain/Origin aus config/site.json.
# Für lokale Tests mit http://localhost:3000: WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
