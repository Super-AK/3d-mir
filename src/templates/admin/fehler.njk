{% extends "layouts/admin.njk" %}

{% block title %}{{ title }} – 3D-MIR Admin{% endblock %}

{% block content %}
  <div class="admin-page-head">
    <div>
      <h1>{{ title }}</h1>
      <p>Die angeforderte Aktion konnte nicht ausgeführt werden.</p>
    </div>
  </div>
  <div class="card admin-panel">
    <div class="alert alert-danger" role="alert"><p>{{ message }}</p></div>
    <div class="form-actions">
      <a class="btn" href="/admin/">Zum Dashboard</a>
      <a class="btn btn-secondary" href="/admin/bestellungen/">Bestellungen</a>
    </div>
  </div>
{% endblock %}
