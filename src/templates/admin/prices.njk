{% extends "layouts/admin.njk" %}

{% block title %}Preise – 3D-MIR Admin{% endblock %}

{% block content %}
  <div class="admin-page-head">
    <div>
      <h1>Preise und Kalkulation</h1>
      <p>Grundwerte, Materialien, Drucker, Nachbearbeitung, Versand und Mengenrabatt verwalten.</p>
    </div>
    {% if hasOverrides %}
      <div class="admin-page-actions">
        <form method="post" action="/admin/preise/zuruecksetzen/">
          <input type="hidden" name="_csrf" value="{{ csrf }}">
          <button class="btn btn-secondary btn-small" type="submit">Auf Grundeinstellung zurücksetzen</button>
        </form>
      </div>
    {% endif %}
  </div>

  {% if publication.pricingStatus == 'PLATZHALTER' %}
    <div class="alert alert-warning" role="status">
      <p><strong>Platzhalter:</strong> Alle Werte sind technische Annahmen und müssen vor dem Livegang vom Betreiber bestätigt werden. Die Grundeinstellung steht in <code>config/pricing.json</code>; Änderungen hier werden in der Datenbank gespeichert und überlagern diese Werte.</p>
    </div>
  {% endif %}
  <div class="alert alert-info" role="status">
    <p><strong>Aktiv:</strong> Nur aktive Materialien, Drucker, Nachbearbeitungen und Versandarten werden im Rechner, Shop und auf der Versandseite angezeigt. Inaktive Einträge bleiben zur Bearbeitung erhalten.</p>
  </div>

  <form class="form" method="post" action="/admin/preise/">
    <input type="hidden" name="_csrf" value="{{ csrf }}">

    <section class="card admin-panel">
      <h2>Grundwerte</h2>
      <div class="form-row">
        <div class="field">
          <label for="meta_min_order">Mindestauftragswert (€)</label>
          <input id="meta_min_order" name="meta_min_order" type="number" min="0" step="0.01" required value="{{ view.metaValues.minOrder }}">
        </div>
        <div class="field">
          <label for="meta_round">Rundung (€)</label>
          <input id="meta_round" name="meta_round" type="number" min="0.01" step="0.01" required value="{{ view.metaValues.round }}">
        </div>
      </div>
      <div class="form-row">
        <div class="field">
          <label for="meta_setup">Rüstkosten (€)</label>
          <input id="meta_setup" name="meta_setup" type="number" min="0" step="0.01" required value="{{ view.metaValues.setup }}">
        </div>
        <div class="field">
          <label for="meta_setup_extra">Rüstkosten je weiteres Teil (€)</label>
          <input id="meta_setup_extra" name="meta_setup_extra" type="number" min="0" step="0.01" required value="{{ view.metaValues.setupExtra }}">
        </div>
      </div>
      <div class="form-row form-row-3">
        <div class="field">
          <label for="calc_wall">Wandstärke (mm)</label>
          <input id="calc_wall" name="calc_wall" type="number" min="0.1" max="10" step="0.1" required value="{{ view.calculationValues.wall }}">
        </div>
        <div class="field">
          <label for="calc_flow">Materialdurchsatz (cm³/h)</label>
          <input id="calc_flow" name="calc_flow" type="number" min="0.1" max="1000" step="0.1" required value="{{ view.calculationValues.flow }}">
        </div>
        <div class="field">
          <label for="calc_waste">Verschnitt (%)</label>
          <input id="calc_waste" name="calc_waste" type="number" min="0" max="100" step="0.1" required value="{{ view.calculationValues.waste }}">
        </div>
      </div>
    </section>

    <section class="card admin-panel">
      <h2>Materialien</h2>
      <p class="text-muted">Farben als kommagetrennte Liste. Mindestens ein Material muss vorhanden sein.</p>
      <div class="table-wrap">
        <table class="admin-edit-table">
          <thead>
            <tr><th>Bezeichnung</th><th>ID</th><th>Dichte (g/cm³)</th><th>Preis je g (€)</th><th>Max. °C</th><th>Aktiv</th><th>Löschen</th></tr>
          </thead>
          <tbody data-add-target="material" data-next-index="1">
            {% for material in view.materials %}
              <tr>
                <td>
                  <input type="hidden" name="material_{{ material.index }}_id" value="{{ material.id }}">
                  <input name="material_{{ material.index }}_label" type="text" maxlength="80" required value="{{ material.label }}">
                </td>
                <td><code class="admin-code">{{ material.id }}</code></td>
                <td><input name="material_{{ material.index }}_density" type="number" min="0.1" max="30" step="0.01" required value="{{ material.densityValue }}"></td>
                <td><input name="material_{{ material.index }}_price" type="number" min="0" max="1000" step="0.001" required value="{{ material.priceValue }}"></td>
                <td><input name="material_{{ material.index }}_max_temp" type="number" min="0" max="500" step="1" required value="{{ material.maxTempValue }}"></td>
                <td><label class="admin-check admin-check-inline"><input type="checkbox" name="material_{{ material.index }}_active" value="1" {% if material.isActive %}checked{% endif %}><span>aktiv</span></label></td>
                <td><label class="admin-check admin-check-inline"><input type="checkbox" name="material_{{ material.index }}_delete" value="1"><span>löschen</span></label></td>
              </tr>
              <tr class="admin-detail-row">
                <td colspan="7">
                  <details>
                    <summary>Farben und Beschreibung</summary>
                    <div class="form-row">
                      <div class="field">
                        <label for="material_{{ material.index }}_colors">Farben (kommagetrennt)</label>
                        <input id="material_{{ material.index }}_colors" name="material_{{ material.index }}_colors" type="text" maxlength="500" value="{{ material.colorsValue }}">
                      </div>
                      <div class="field">
                        <label for="material_{{ material.index }}_properties">Eigenschaften</label>
                        <input id="material_{{ material.index }}_properties" name="material_{{ material.index }}_properties" type="text" maxlength="300" value="{{ material.properties }}">
                      </div>
                    </div>
                    <div class="form-row">
                      <div class="field">
                        <label for="material_{{ material.index }}_use_cases">Anwendungen</label>
                        <input id="material_{{ material.index }}_use_cases" name="material_{{ material.index }}_use_cases" type="text" maxlength="300" value="{{ material.useCases }}">
                      </div>
                      <div class="field">
                        <label for="material_{{ material.index }}_notes">Hinweise</label>
                        <input id="material_{{ material.index }}_notes" name="material_{{ material.index }}_notes" type="text" maxlength="500" value="{{ material.notes }}">
                      </div>
                    </div>
                  </details>
                </td>
              </tr>
            {% endfor %}
            <tr class="admin-new-row" data-new-row data-row-index="0">
              <td>
                <input name="new_material_0_label" type="text" maxlength="80" placeholder="Neues Material">
              </td>
              <td><span class="text-muted">wird erzeugt</span></td>
              <td><input name="new_material_0_density" type="number" min="0.1" max="30" step="0.01" placeholder="1.24"></td>
              <td><input name="new_material_0_price" type="number" min="0" max="1000" step="0.001" placeholder="0.050"></td>
              <td><input name="new_material_0_max_temp" type="number" min="0" max="500" step="1" placeholder="60"></td>
              <td><label class="admin-check admin-check-inline"><input type="checkbox" name="new_material_0_active" value="1" checked><span>aktiv</span></label></td>
              <td></td>
            </tr>
            <tr class="admin-new-row admin-detail-row" data-new-row data-row-index="0">
              <td colspan="7">
                <div class="form-row">
                  <div class="field">
                    <label for="new_material_0_colors">Farben (kommagetrennt)</label>
                    <input id="new_material_0_colors" name="new_material_0_colors" type="text" maxlength="500" placeholder="Schwarz, Weiß, Blau">
                  </div>
                  <div class="field">
                    <label for="new_material_0_properties">Eigenschaften</label>
                    <input id="new_material_0_properties" name="new_material_0_properties" type="text" maxlength="300">
                  </div>
                </div>
                <div class="form-row">
                  <div class="field">
                    <label for="new_material_0_use_cases">Anwendungen</label>
                    <input id="new_material_0_use_cases" name="new_material_0_use_cases" type="text" maxlength="300">
                  </div>
                  <div class="field">
                    <label for="new_material_0_notes">Hinweise</label>
                    <input id="new_material_0_notes" name="new_material_0_notes" type="text" maxlength="500">
                  </div>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <template data-new-rows="material">
        <tr class="admin-new-row" data-new-row data-row-index="__INDEX__">
          <td>
            <input name="new_material___INDEX___label" type="text" maxlength="80" placeholder="Neues Material">
          </td>
          <td><span class="text-muted">wird erzeugt</span></td>
          <td><input name="new_material___INDEX___density" type="number" min="0.1" max="30" step="0.01" placeholder="1.24"></td>
          <td><input name="new_material___INDEX___price" type="number" min="0" max="1000" step="0.001" placeholder="0.050"></td>
          <td><input name="new_material___INDEX___max_temp" type="number" min="0" max="500" step="1" placeholder="60"></td>
          <td><label class="admin-check admin-check-inline"><input type="checkbox" name="new_material___INDEX___active" value="1" checked><span>aktiv</span></label></td>
          <td></td>
        </tr>
        <tr class="admin-new-row admin-detail-row" data-new-row data-row-index="__INDEX__">
          <td colspan="7">
            <div class="form-row">
              <div class="field">
                <label for="new_material___INDEX___colors">Farben (kommagetrennt)</label>
                <input id="new_material___INDEX___colors" name="new_material___INDEX___colors" type="text" maxlength="500" placeholder="Schwarz, Weiß, Blau">
              </div>
              <div class="field">
                <label for="new_material___INDEX___properties">Eigenschaften</label>
                <input id="new_material___INDEX___properties" name="new_material___INDEX___properties" type="text" maxlength="300">
              </div>
            </div>
            <div class="form-row">
              <div class="field">
                <label for="new_material___INDEX___use_cases">Anwendungen</label>
                <input id="new_material___INDEX___use_cases" name="new_material___INDEX___use_cases" type="text" maxlength="300">
              </div>
              <div class="field">
                <label for="new_material___INDEX___notes">Hinweise</label>
                <input id="new_material___INDEX___notes" name="new_material___INDEX___notes" type="text" maxlength="500">
              </div>
            </div>
          </td>
        </tr>
      </template>
      <p class="admin-add-row">
        <button type="button" class="btn btn-secondary btn-small" data-add-row="material">+ Weiteres Material</button>
      </p>
      <p class="hint">Zum Anlegen die Zeile „Neues Material“ ausfüllen. Über „Weiteres Material“ lassen sich mehrere Einträge gleichzeitig vorbereiten. Leere Zeilen werden ignoriert.</p>
    </section>

    <section class="card admin-panel">
      <h2>Drucker</h2>
      <p class="text-muted">Bauraum in mm. Ohne Materialauswahl wird der Drucker für alle Materialien angeboten.</p>
      <div class="table-wrap">
        <table class="admin-edit-table">
          <thead>
            <tr><th>Bezeichnung</th><th>Bauraum X/Y/Z (mm)</th><th>Maschinenstunde (€)</th><th>Materialien</th><th>Aktiv</th><th>Löschen</th></tr>
          </thead>
          <tbody data-add-target="printer" data-next-index="1">
            {% for printer in view.printers %}
              <tr>
                <td>
                  <input type="hidden" name="printer_{{ printer.index }}_id" value="{{ printer.id }}">
                  <input name="printer_{{ printer.index }}_label" type="text" maxlength="80" required value="{{ printer.label }}">
                </td>
                <td class="admin-inline-numbers">
                  <input name="printer_{{ printer.index }}_x" type="number" min="10" max="2000" step="1" required value="{{ printer.xValue }}" aria-label="Bauraum X">
                  <span>×</span>
                  <input name="printer_{{ printer.index }}_y" type="number" min="10" max="2000" step="1" required value="{{ printer.yValue }}" aria-label="Bauraum Y">
                  <span>×</span>
                  <input name="printer_{{ printer.index }}_z" type="number" min="10" max="2000" step="1" required value="{{ printer.zValue }}" aria-label="Bauraum Z">
                </td>
                <td><input name="printer_{{ printer.index }}_rate" type="number" min="0" max="1000" step="0.01" required value="{{ printer.rateValue }}"></td>
                <td>
                  <div class="admin-check-list">
                    {% for material in view.materialOptions %}
                      <label class="admin-check admin-check-inline">
                        <input type="checkbox" name="printer_{{ printer.index }}_material_{{ material.id }}" value="1" {% if printer.materialChecks[material.id] %}checked{% endif %}>
                        <span>{{ material.label }}</span>
                      </label>
                    {% endfor %}
                  </div>
                </td>
                <td><label class="admin-check admin-check-inline"><input type="checkbox" name="printer_{{ printer.index }}_active" value="1" {% if printer.isActive %}checked{% endif %}><span>aktiv</span></label></td>
                <td><label class="admin-check admin-check-inline"><input type="checkbox" name="printer_{{ printer.index }}_delete" value="1"><span>löschen</span></label></td>
              </tr>
              <tr class="admin-detail-row">
                <td colspan="6">
                  <details>
                    <summary>Hinweis zum Drucker</summary>
                    <div class="field">
                      <label for="printer_{{ printer.index }}_note">Interner Hinweis</label>
                      <input id="printer_{{ printer.index }}_note" name="printer_{{ printer.index }}_note" type="text" maxlength="500" value="{{ printer.note }}">
                    </div>
                  </details>
                </td>
              </tr>
            {% endfor %}
            <tr class="admin-new-row" data-new-row data-row-index="0">
              <td><input name="new_printer_0_label" type="text" maxlength="80" placeholder="Neuer Drucker"></td>
              <td class="admin-inline-numbers">
                <input name="new_printer_0_x" type="number" min="10" max="2000" step="1" placeholder="220" aria-label="Bauraum X">
                <span>×</span>
                <input name="new_printer_0_y" type="number" min="10" max="2000" step="1" placeholder="220" aria-label="Bauraum Y">
                <span>×</span>
                <input name="new_printer_0_z" type="number" min="10" max="2000" step="1" placeholder="250" aria-label="Bauraum Z">
              </td>
              <td><input name="new_printer_0_rate" type="number" min="0" max="1000" step="0.01" placeholder="1.00"></td>
              <td>
                <div class="admin-check-list">
                  {% for material in view.materialOptions %}
                    <label class="admin-check admin-check-inline">
                      <input type="checkbox" name="new_printer_0_material_{{ material.id }}" value="1" checked>
                      <span>{{ material.label }}</span>
                    </label>
                  {% endfor %}
                </div>
              </td>
              <td><label class="admin-check admin-check-inline"><input type="checkbox" name="new_printer_0_active" value="1" checked><span>aktiv</span></label></td>
              <td></td>
            </tr>
            <tr class="admin-new-row admin-detail-row" data-new-row data-row-index="0">
              <td colspan="6">
                <div class="field">
                  <label for="new_printer_0_note">Hinweis zum neuen Drucker</label>
                  <input id="new_printer_0_note" name="new_printer_0_note" type="text" maxlength="500">
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <template data-new-rows="printer">
        <tr class="admin-new-row" data-new-row data-row-index="__INDEX__">
          <td><input name="new_printer___INDEX___label" type="text" maxlength="80" placeholder="Neuer Drucker"></td>
          <td class="admin-inline-numbers">
            <input name="new_printer___INDEX___x" type="number" min="10" max="2000" step="1" placeholder="220" aria-label="Bauraum X">
            <span>×</span>
            <input name="new_printer___INDEX___y" type="number" min="10" max="2000" step="1" placeholder="220" aria-label="Bauraum Y">
            <span>×</span>
            <input name="new_printer___INDEX___z" type="number" min="10" max="2000" step="1" placeholder="250" aria-label="Bauraum Z">
          </td>
          <td><input name="new_printer___INDEX___rate" type="number" min="0" max="1000" step="0.01" placeholder="1.00"></td>
          <td>
            <div class="admin-check-list">
              {% for material in view.materialOptions %}
                <label class="admin-check admin-check-inline">
                  <input type="checkbox" name="new_printer___INDEX___material_{{ material.id }}" value="1" checked>
                  <span>{{ material.label }}</span>
                </label>
              {% endfor %}
            </div>
          </td>
          <td><label class="admin-check admin-check-inline"><input type="checkbox" name="new_printer___INDEX___active" value="1" checked><span>aktiv</span></label></td>
          <td></td>
        </tr>
        <tr class="admin-new-row admin-detail-row" data-new-row data-row-index="__INDEX__">
          <td colspan="6">
            <div class="field">
              <label for="new_printer___INDEX___note">Hinweis zum neuen Drucker</label>
              <input id="new_printer___INDEX___note" name="new_printer___INDEX___note" type="text" maxlength="500">
            </div>
          </td>
        </tr>
      </template>
      <p class="admin-add-row">
        <button type="button" class="btn btn-secondary btn-small" data-add-row="printer">+ Weiteren Drucker</button>
      </p>
    </section>

    <section class="card admin-panel">
      <h2>Nachbearbeitung</h2>
      <div class="table-wrap">
        <table class="admin-edit-table">
          <thead><tr><th>Bezeichnung</th><th>Zuschlag (%)</th><th>Preis je Teil (€)</th><th>Aktiv</th><th>Löschen</th></tr></thead>
          <tbody data-add-target="coating" data-next-index="1">
            {% for coating in view.coatings %}
              <tr>
                <td>
                  <input type="hidden" name="coating_{{ coating.index }}_id" value="{{ coating.id }}">
                  <input name="coating_{{ coating.index }}_label" type="text" maxlength="80" required value="{{ coating.label }}">
                </td>
                <td><input name="coating_{{ coating.index }}_percent" type="number" min="0" max="100" step="0.1" required value="{{ coating.percentValue }}"></td>
                <td><input name="coating_{{ coating.index }}_price" type="number" min="0" max="10000" step="0.01" required value="{{ coating.priceValue }}"></td>
                <td><label class="admin-check admin-check-inline"><input type="checkbox" name="coating_{{ coating.index }}_active" value="1" {% if coating.isActive %}checked{% endif %}><span>aktiv</span></label></td>
                <td><label class="admin-check admin-check-inline"><input type="checkbox" name="coating_{{ coating.index }}_delete" value="1"><span>löschen</span></label></td>
              </tr>
            {% endfor %}
            <tr class="admin-new-row" data-new-row data-row-index="0">
              <td><input name="new_coating_0_label" type="text" maxlength="80" placeholder="Neue Nachbearbeitung"></td>
              <td><input name="new_coating_0_percent" type="number" min="0" max="100" step="0.1" placeholder="0"></td>
              <td><input name="new_coating_0_price" type="number" min="0" max="10000" step="0.01" placeholder="0.00"></td>
              <td><label class="admin-check admin-check-inline"><input type="checkbox" name="new_coating_0_active" value="1" checked><span>aktiv</span></label></td>
              <td></td>
            </tr>
          </tbody>
        </table>
      </div>
      <template data-new-rows="coating">
        <tr class="admin-new-row" data-new-row data-row-index="__INDEX__">
          <td><input name="new_coating___INDEX___label" type="text" maxlength="80" placeholder="Neue Nachbearbeitung"></td>
          <td><input name="new_coating___INDEX___percent" type="number" min="0" max="100" step="0.1" placeholder="0"></td>
          <td><input name="new_coating___INDEX___price" type="number" min="0" max="10000" step="0.01" placeholder="0.00"></td>
          <td><label class="admin-check admin-check-inline"><input type="checkbox" name="new_coating___INDEX___active" value="1" checked><span>aktiv</span></label></td>
          <td></td>
        </tr>
      </template>
      <p class="admin-add-row">
        <button type="button" class="btn btn-secondary btn-small" data-add-row="coating">+ Weitere Nachbearbeitung</button>
      </p>
      <p class="hint">Mindestens eine Option muss vorhanden sein. „Ohne Nachbearbeitung“ sollte erhalten bleiben.</p>
    </section>

    <section class="card admin-panel">
      <h2>Versand</h2>
      <p class="text-muted">Diese Angaben erscheinen auch auf der öffentlichen Seite <a href="/versand/" target="_blank" rel="noopener">Versandarten und Kosten</a>. Inaktive Versandarten werden dort und im Checkout nicht angeboten.</p>
      <div class="table-wrap">
        <table class="admin-edit-table">
          <thead><tr><th>Bezeichnung</th><th>Preis (€)</th><th>Lieferzeit</th><th>Aktiv</th><th>Löschen</th></tr></thead>
          <tbody data-add-target="shipping" data-next-index="1">
            {% for method in view.shipping %}
              <tr>
                <td>
                  <input type="hidden" name="shipping_{{ method.index }}_id" value="{{ method.id }}">
                  <input name="shipping_{{ method.index }}_label" type="text" maxlength="80" required value="{{ method.label }}">
                </td>
                <td><input name="shipping_{{ method.index }}_price" type="number" min="0" max="1000" step="0.01" required value="{{ method.priceValue }}"></td>
                <td><input name="shipping_{{ method.index }}_days" type="text" maxlength="80" value="{{ method.deliveryDays }}"></td>
                <td><label class="admin-check admin-check-inline"><input type="checkbox" name="shipping_{{ method.index }}_active" value="1" {% if method.isActive %}checked{% endif %}><span>aktiv</span></label></td>
                <td><label class="admin-check admin-check-inline"><input type="checkbox" name="shipping_{{ method.index }}_delete" value="1"><span>löschen</span></label></td>
              </tr>
            {% endfor %}
            <tr class="admin-new-row" data-new-row data-row-index="0">
              <td><input name="new_shipping_0_label" type="text" maxlength="80" placeholder="Neue Versandart"></td>
              <td><input name="new_shipping_0_price" type="number" min="0" max="1000" step="0.01" placeholder="0.00"></td>
              <td><input name="new_shipping_0_days" type="text" maxlength="80" placeholder="2–5 Werktage"></td>
              <td><label class="admin-check admin-check-inline"><input type="checkbox" name="new_shipping_0_active" value="1" checked><span>aktiv</span></label></td>
              <td></td>
            </tr>
          </tbody>
        </table>
      </div>
      <template data-new-rows="shipping">
        <tr class="admin-new-row" data-new-row data-row-index="__INDEX__">
          <td><input name="new_shipping___INDEX___label" type="text" maxlength="80" placeholder="Neue Versandart"></td>
          <td><input name="new_shipping___INDEX___price" type="number" min="0" max="1000" step="0.01" placeholder="0.00"></td>
          <td><input name="new_shipping___INDEX___days" type="text" maxlength="80" placeholder="2–5 Werktage"></td>
          <td><label class="admin-check admin-check-inline"><input type="checkbox" name="new_shipping___INDEX___active" value="1" checked><span>aktiv</span></label></td>
          <td></td>
        </tr>
      </template>
      <p class="admin-add-row">
        <button type="button" class="btn btn-secondary btn-small" data-add-row="shipping">+ Weitere Versandart</button>
      </p>
      <div class="form-row">
        <div class="field">
          <label for="shipping_free_from">Kostenloser Versand ab (€)</label>
          <input id="shipping_free_from" name="shipping_free_from" type="number" min="0" max="100000" step="0.01" required value="{{ view.metaValues.freeShippingFrom }}">
          <span class="hint">0 = kein kostenloser Versand.</span>
        </div>
      </div>
    </section>

    <section class="card admin-panel">
      <h2>Versandoptionen</h2>
      <p class="text-muted">Zusatzoptionen wie Expressversand oder Geschenkverpackung. Sie werden pro Produkt zugewiesen und im Checkout als zusätzliche Kosten angezeigt.</p>
      <div class="table-wrap">
        <table class="admin-edit-table">
          <thead><tr><th>Bezeichnung</th><th>Preis (€)</th><th>Hinweis</th><th>Aktiv</th><th>Löschen</th></tr></thead>
          <tbody data-add-target="shipping_option" data-next-index="1">
            {% for option in view.shippingOptions %}
              <tr>
                <td>
                  <input type="hidden" name="shipping_option_{{ option.index }}_id" value="{{ option.id }}">
                  <input name="shipping_option_{{ option.index }}_label" type="text" maxlength="80" required value="{{ option.label }}">
                </td>
                <td><input name="shipping_option_{{ option.index }}_price" type="number" min="0" max="1000" step="0.01" required value="{{ option.priceValue }}"></td>
                <td><input name="shipping_option_{{ option.index }}_note" type="text" maxlength="200" value="{{ option.note }}"></td>
                <td><label class="admin-check admin-check-inline"><input type="checkbox" name="shipping_option_{{ option.index }}_active" value="1" {% if option.isActive %}checked{% endif %}><span>aktiv</span></label></td>
                <td><label class="admin-check admin-check-inline"><input type="checkbox" name="shipping_option_{{ option.index }}_delete" value="1"><span>löschen</span></label></td>
              </tr>
            {% endfor %}
            <tr class="admin-new-row" data-new-row data-row-index="0">
              <td><input name="new_shipping_option_0_label" type="text" maxlength="80" placeholder="z. B. Expressversand"></td>
              <td><input name="new_shipping_option_0_price" type="number" min="0" max="1000" step="0.01" placeholder="0.00"></td>
              <td><input name="new_shipping_option_0_note" type="text" maxlength="200" placeholder="z. B. Zustellung am nächsten Werktag"></td>
              <td><label class="admin-check admin-check-inline"><input type="checkbox" name="new_shipping_option_0_active" value="1" checked><span>aktiv</span></label></td>
              <td></td>
            </tr>
          </tbody>
        </table>
      </div>
      <template data-new-rows="shipping_option">
        <tr class="admin-new-row" data-new-row data-row-index="__INDEX__">
          <td><input name="new_shipping_option___INDEX___label" type="text" maxlength="80" placeholder="z. B. Expressversand"></td>
          <td><input name="new_shipping_option___INDEX___price" type="number" min="0" max="1000" step="0.01" placeholder="0.00"></td>
          <td><input name="new_shipping_option___INDEX___note" type="text" maxlength="200" placeholder="z. B. Zustellung am nächsten Werktag"></td>
          <td><label class="admin-check admin-check-inline"><input type="checkbox" name="new_shipping_option___INDEX___active" value="1" checked><span>aktiv</span></label></td>
          <td></td>
        </tr>
      </template>
      <p class="admin-add-row">
        <button type="button" class="btn btn-secondary btn-small" data-add-row="shipping_option">+ Weitere Versandoption</button>
      </p>
      <p class="hint">Diese Optionen erscheinen nur bei Produkten, denen sie zugeordnet wurden.</p>
    </section>

    <section class="card admin-panel">
      <h2>Mengenrabatt</h2>
      <div class="table-wrap">
        <table class="admin-edit-table">
          <thead><tr><th>Ab Stückzahl</th><th>Rabatt (%)</th><th>Löschen</th></tr></thead>
          <tbody data-add-target="discount" data-next-index="1">
            {% for tier in view.discounts %}
              <tr>
                <td><input name="discount_{{ tier.index }}_min" type="number" min="1" max="100000" step="1" required value="{{ tier.minValue }}"></td>
                <td><input name="discount_{{ tier.index }}_percent" type="number" min="0" max="100" step="0.1" required value="{{ tier.percentValue }}"></td>
                <td><label class="admin-check admin-check-inline"><input type="checkbox" name="discount_{{ tier.index }}_delete" value="1"><span>löschen</span></label></td>
              </tr>
            {% endfor %}
            <tr class="admin-new-row" data-new-row data-row-index="0">
              <td><input name="new_discount_0_min" type="number" min="1" max="100000" step="1" placeholder="z. B. 50"></td>
              <td><input name="new_discount_0_percent" type="number" min="0" max="100" step="0.1" placeholder="z. B. 25"></td>
              <td></td>
            </tr>
          </tbody>
        </table>
      </div>
      <template data-new-rows="discount">
        <tr class="admin-new-row" data-new-row data-row-index="__INDEX__">
          <td><input name="new_discount___INDEX___min" type="number" min="1" max="100000" step="1" placeholder="z. B. 50"></td>
          <td><input name="new_discount___INDEX___percent" type="number" min="0" max="100" step="0.1" placeholder="z. B. 25"></td>
          <td></td>
        </tr>
      </template>
      <p class="admin-add-row">
        <button type="button" class="btn btn-secondary btn-small" data-add-row="discount">+ Weitere Rabattstaffel</button>
      </p>
      <p class="hint">Leere Liste bedeutet: kein Mengenrabatt.</p>
    </section>

    <div class="form-actions">
      <button class="btn" type="submit">Alle Änderungen speichern</button>
      <a class="btn btn-secondary" href="/admin/">Zurück</a>
    </div>
    <p class="hint">Löschmarkierungen werden beim Speichern angewendet. Mindestens ein Material, ein Drucker, eine Nachbearbeitung und eine Versandart müssen bestehen bleiben.</p>
  </form>
{% endblock %}
