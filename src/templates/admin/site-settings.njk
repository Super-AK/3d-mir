{% extends "layouts/admin.njk" %}

{% block title %}Stammdaten – 3D-MIR Admin{% endblock %}

{% block content %}
  <div class="admin-page-head">
    <div>
      <h1>Stammdaten</h1>
      <p>Geschäftsdaten, Kontaktangaben, Kanäle, SEO, Startseiten-Texte und Bilder pflegen.</p>
    </div>
  </div>

  {% if meldung.gespeichert %}
    <div class="alert alert-success" role="status"><p>Die Änderungen wurden gespeichert.</p></div>
  {% endif %}
  {% if meldung.fehler %}
    <div class="alert alert-danger" role="alert"><p>{{ meldung.fehler }}</p></div>
  {% endif %}

  <div class="alert alert-info" role="status">
    <p>Diese Angaben erscheinen auf der Website, in E-Mails und in strukturierten Daten (JSON-LD). Änderungen wirken sofort, ohne Neustart. Die Werte aus <code>config/site.json</code> dienen als Grundeinstellung.</p>
  </div>

  <form class="form card admin-panel" method="post" action="/admin/stammdaten/">
    <input type="hidden" name="_csrf" value="{{ csrf }}">

    <fieldset class="admin-fieldset">
      <legend>Geschäftsdaten</legend>
      <div class="form-row">
        <div class="field">
          <label for="businessName">Kurzname</label>
          <input id="businessName" name="businessName" type="text" maxlength="80" required value="{{ settings.business.name }}">
        </div>
        <div class="field">
          <label for="businessLegalName">Vollständiger Name (Recht)</label>
          <input id="businessLegalName" name="businessLegalName" type="text" maxlength="160" required value="{{ settings.business.legalName }}">
        </div>
      </div>
      <div class="form-row">
        <div class="field">
          <label for="businessOwner">Inhaber</label>
          <input id="businessOwner" name="businessOwner" type="text" maxlength="120" value="{{ settings.business.owner }}">
        </div>
        <div class="field">
          <label for="businessEmail">E-Mail</label>
          <input id="businessEmail" name="businessEmail" type="email" maxlength="200" required value="{{ settings.business.email }}">
        </div>
      </div>
      <div class="form-row">
        <div class="field">
          <label for="businessStreet">Straße und Hausnummer</label>
          <input id="businessStreet" name="businessStreet" type="text" maxlength="120" value="{{ settings.business.street }}">
        </div>
        <div class="field field-small">
          <label for="businessZip">PLZ</label>
          <input id="businessZip" name="businessZip" type="text" maxlength="20" value="{{ settings.business.zip }}">
        </div>
        <div class="field">
          <label for="businessCity">Ort</label>
          <input id="businessCity" name="businessCity" type="text" maxlength="120" value="{{ settings.business.city }}">
        </div>
      </div>
      <div class="form-row">
        <div class="field">
          <label for="businessCountry">Land</label>
          <input id="businessCountry" name="businessCountry" type="text" maxlength="120" value="{{ settings.business.country }}">
        </div>
        <div class="field field-small">
          <label for="businessCountryCode">Ländercode</label>
          <input id="businessCountryCode" name="businessCountryCode" type="text" maxlength="2" pattern="[A-Za-z]{2}" value="{{ settings.business.countryCode }}">
        </div>
        <div class="field">
          <label for="businessPhone">Telefon</label>
          <input id="businessPhone" name="businessPhone" type="tel" maxlength="60" value="{{ settings.business.phone }}">
        </div>
      </div>
      <div class="form-row">
        <div class="field">
          <label for="businessPhoneHref">Telefon-Link (optional)</label>
          <input id="businessPhoneHref" name="businessPhoneHref" type="text" maxlength="60" value="{{ settings.business.phoneHref }}">
          <span class="hint">Leer lassen: wird automatisch aus der Telefonnummer erzeugt.</span>
        </div>
        <div class="field">
          <label for="businessVatNote">Steuerhinweis</label>
          <input id="businessVatNote" name="businessVatNote" type="text" maxlength="300" value="{{ settings.business.vatNote }}">
        </div>
      </div>
      <label class="checkbox">
        <input type="checkbox" name="businessSmallBusiness" value="1" {% if settings.business.smallBusiness %}checked{% endif %}>
        <span>Kleinunternehmer nach § 19 UStG (kein Mehrwertsteuerausweis)</span>
      </label>
    </fieldset>

    <details class="admin-field-collapse" data-collapse="site-channels">
      <summary>
        <span>Kanäle</span>
        <span class="admin-collapse-preview">{{ settings.channels.etsy.label or 'Etsy' }} · {{ settings.channels.classifieds.label or 'Kleinanzeigen' }}</span>
      </summary>
      <div class="admin-collapse-body">
      <div class="form-row">
        <div class="field">
          <label for="etsyLabel">Etsy-Bezeichnung</label>
          <input id="etsyLabel" name="etsyLabel" type="text" maxlength="80" value="{{ settings.channels.etsy.label }}">
        </div>
        <div class="field">
          <label for="etsyUrl">Etsy-Shop-URL</label>
          <input id="etsyUrl" name="etsyUrl" type="url" maxlength="500" value="{{ settings.channels.etsy.url }}">
        </div>
      </div>
      <div class="field">
        <label for="etsyReviewsUrl">Etsy-Bewertungs-URL (optional)</label>
        <input id="etsyReviewsUrl" name="etsyReviewsUrl" type="text" maxlength="500" value="{{ settings.channels.etsy.reviewsUrl }}">
      </div>
      <div class="form-row">
        <div class="field">
          <label for="classifiedsLabel">Kleinanzeigen-Bezeichnung</label>
          <input id="classifiedsLabel" name="classifiedsLabel" type="text" maxlength="80" value="{{ settings.channels.classifieds.label }}">
        </div>
        <div class="field">
          <label for="classifiedsUrl">Kleinanzeigen-URL</label>
          <input id="classifiedsUrl" name="classifiedsUrl" type="url" maxlength="500" value="{{ settings.channels.classifieds.url }}">
        </div>
      </div>
      </div>
    </details>

    <details class="admin-field-collapse" data-collapse="site-contact">
      <summary>
        <span>Kontakt und SEO</span>
        <span class="admin-collapse-preview">{{ settings.seo.siteName or 'SEO-Name' }} · {{ settings.contact.responseTime or 'Antwortzeit offen' }}</span>
      </summary>
      <div class="admin-collapse-body">
      <div class="form-row">
        <div class="field">
          <label for="responseTime">Antwortzeit</label>
          <input id="responseTime" name="responseTime" type="text" maxlength="200" value="{{ settings.contact.responseTime }}">
        </div>
        <div class="field">
          <label for="appointmentNote">Abholhinweis</label>
          <input id="appointmentNote" name="appointmentNote" type="text" maxlength="200" value="{{ settings.contact.appointmentNote }}">
        </div>
      </div>
      <div class="field">
        <label for="siteName">SEO-Name der Website</label>
        <input id="siteName" name="siteName" type="text" maxlength="120" value="{{ settings.seo.siteName }}">
      </div>
      <div class="field">
        <label for="seoTitle">SEO-Titel Startseite</label>
        <input id="seoTitle" name="seoTitle" type="text" maxlength="200" value="{{ settings.seo.defaultTitle }}">
      </div>
      <div class="field">
        <label for="seoDescription">SEO-Beschreibung</label>
        <textarea id="seoDescription" name="seoDescription" rows="2" maxlength="400">{{ settings.seo.defaultDescription }}</textarea>
      </div>
      </div>
    </details>

    <div class="form-actions">
      <button class="btn" type="submit">Stammdaten speichern</button>
    </div>
  </form>

  <section class="card admin-panel">
    <details class="admin-field-collapse" data-collapse="site-images">
      <summary>
        <h2>Bilder</h2>
        <span class="admin-collapse-preview">{% if galleryIsDefault %}Standardgalerie{% else %}{{ galleryItems.length }} eigene Galeriebilder{% endif %} · Logo, Hero und mehr</span>
      </summary>
      <div class="admin-collapse-body">
    <p class="text-muted">Logo und Favicon (PNG/JPG/WebP, max. 5 MB), Hero-, Service-, Material- und Rechnerbild sowie bis zu acht Galeriebilder. Über das Stiftsymbol lässt sich jedes Bild in einem Fenster auswählen oder hineinziehen. Ohne eigene Bilder werden die mitgelieferten Motive verwendet.</p>

    {% set imageSlots = [
      { slot: 'logo', label: 'Logo', preview: logoUrl, accept: 'image/png,image/jpeg,image/webp', max: 5, typeLabel: 'PNG, JPG oder WebP', resetLabel: 'Logo entfernen' },
      { slot: 'favicon', label: 'Favicon', preview: faviconPreview, accept: 'image/png,image/jpeg,image/webp', max: 5, typeLabel: 'PNG, JPG oder WebP (quadratisch empfohlen)', resetLabel: 'Favicon entfernen' },
      { slot: 'hero', label: 'Hero-Bild', preview: heroPreview, accept: 'image/jpeg,image/png,image/webp,image/avif', max: 12, typeLabel: 'JPG, PNG, WebP oder AVIF', resetLabel: 'Auf Standard zurücksetzen' },
      { slot: 'service', label: 'Service-Bild', preview: servicePreview, accept: 'image/jpeg,image/png,image/webp,image/avif', max: 12, typeLabel: 'JPG, PNG, WebP oder AVIF', resetLabel: 'Auf Standard zurücksetzen' },
      { slot: 'materials', label: 'Material-Bild (Leistungen)', preview: materialsPreview, accept: 'image/jpeg,image/png,image/webp,image/avif', max: 12, typeLabel: 'JPG, PNG, WebP oder AVIF', resetLabel: 'Auf Standard zurücksetzen' },
      { slot: 'calculator', label: 'Rechner-Bild', preview: calculatorPreview, accept: 'image/jpeg,image/png,image/webp,image/avif', max: 12, typeLabel: 'JPG, PNG, WebP oder AVIF', resetLabel: 'Auf Standard zurücksetzen' }
    ] %}

    <div class="admin-image-grid">
      {% for item in imageSlots %}
        <figure class="admin-image-card" data-image-card data-slot="{{ item.slot }}" data-label="{{ item.label }}" data-accept="{{ item.accept }}" data-max-size="{{ item.max }}" data-type-label="{{ item.typeLabel }}">
          <figcaption><strong>{{ item.label }}</strong></figcaption>
          <button type="button" class="admin-image-edit" data-image-edit aria-label="{{ item.label }} bearbeiten" title="Bild bearbeiten">
            <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M4 16h3l8.5-8.5a1.8 1.8 0 0 0-2.5-2.5L4.5 13.5V16Z"/></svg>
          </button>
          {% if item.preview %}<img src="{{ item.preview }}" alt="{{ item.label }}">{% endif %}
          <form method="post" action="/admin/stammdaten/bilder/entfernen/">
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <input type="hidden" name="slot" value="{{ item.slot }}">
            <button class="btn btn-secondary btn-small" type="submit" {% if not settings.images[item.slot] %}disabled{% endif %}>{{ item.resetLabel }}</button>
          </form>
        </figure>
      {% endfor %}
    </div>

    <h3 class="admin-section-head">
      <span>Galerie</span>
      <button type="button" class="btn btn-secondary btn-small" data-gallery-edit data-gallery-remaining="{{ galleryRemaining }}" aria-label="Galeriebilder bearbeiten">
        <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M4 16h3l8.5-8.5a1.8 1.8 0 0 0-2.5-2.5L4.5 13.5V16Z"/></svg>
        Galeriebilder bearbeiten
      </button>
    </h3>

    {% if galleryIsDefault %}
      <p class="text-muted">Aktuell wird die mitgelieferte Standardgalerie mit acht Bildern verwendet. Eigene Bilder ersetzen die Standardgalerie.</p>
    {% elif galleryItems.length > 0 %}
      <p class="text-muted">{{ galleryItems.length }} von 8 eigenen Galeriebildern hinterlegt. Reihenfolge per Ziehen am Griff oder mit den Pfeiltasten ändern; Alternativtexte werden auf der Startseite für Screenreader und Suchmaschinen verwendet.</p>
      <form method="post" action="/admin/stammdaten/galerie/" class="admin-gallery-form" data-gallery-order-form>
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <input type="hidden" name="order" value="" data-gallery-order>
        <div class="admin-gallery-list" data-gallery-order-list>
          {% for item in galleryItems %}
            <div class="admin-gallery-item" data-gallery-item data-key="{{ item.key }}">
              <span class="admin-gallery-handle" draggable="true" data-gallery-handle title="Zum Verschieben ziehen" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="16" height="16" focusable="false"><path fill="currentColor" d="M5 3h2v2H5V3Zm4 0h2v2H9V3ZM5 7h2v2H5V7Zm4 0h2v2H9V7Zm-4 4h2v2H5v-2Zm4 0h2v2H9v-2Z"/></svg>
              </span>
              <img src="{{ item.preview }}" alt="Galeriebild {{ loop.index }}">
              <div class="admin-gallery-fields">
                <label for="galleryAlt{{ loop.index0 }}">Alternativtext</label>
                <input id="galleryAlt{{ loop.index0 }}" name="alt-{{ loop.index0 }}" type="text" maxlength="200" value="{{ item.alt }}" placeholder="Beschreibung des Bildes">
                <input type="hidden" name="key-{{ loop.index0 }}" value="{{ item.key }}">
              </div>
              <div class="admin-gallery-actions">
                <button type="button" class="btn btn-secondary btn-small" data-gallery-up aria-label="Galeriebild nach oben verschieben" title="Nach oben">↑</button>
                <button type="button" class="btn btn-secondary btn-small" data-gallery-down aria-label="Galeriebild nach unten verschieben" title="Nach unten">↓</button>
                <button type="submit" name="removeKey" value="{{ item.key }}" class="btn btn-danger btn-small" formnovalidate>Entfernen</button>
              </div>
            </div>
          {% endfor %}
        </div>
        <div class="form-actions">
          <button class="btn" type="submit">Reihenfolge und Alternativtexte speichern</button>
        </div>
      </form>
      <form method="post" action="/admin/stammdaten/bilder/entfernen/" class="mt-2">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <input type="hidden" name="slot" value="gallery">
        <input type="hidden" name="reset" value="1">
        <button class="btn btn-secondary btn-small" type="submit">Standardgalerie wiederherstellen</button>
      </form>
    {% else %}
      <p class="text-muted">Es sind keine eigenen Galeriebilder hinterlegt. Der Referenzbereich wird auf der Startseite ausgeblendet.</p>
      <form method="post" action="/admin/stammdaten/bilder/entfernen/">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <input type="hidden" name="slot" value="gallery">
        <input type="hidden" name="reset" value="1">
        <button class="btn btn-secondary btn-small" type="submit">Standardgalerie wiederherstellen</button>
      </form>
    {% endif %}

    <noscript>
      <div class="alert alert-info">
        <p>JavaScript ist deaktiviert. Bitte nutzen Sie das folgende Formular zum Hochladen der Bilder.</p>
      </div>
      <form class="form" method="post" action="/admin/stammdaten/bilder/" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <div class="form-row">
          <div class="field">
            <label for="logoUpload">Logo ersetzen</label>
            <input id="logoUpload" name="logo" type="file" accept="image/png,image/jpeg,image/webp">
          </div>
          <div class="field">
            <label for="heroUpload">Hero-Bild ersetzen</label>
            <input id="heroUpload" name="hero" type="file" accept="image/jpeg,image/png,image/webp,image/avif">
          </div>
          <div class="field">
            <label for="serviceUpload">Service-Bild ersetzen</label>
            <input id="serviceUpload" name="service" type="file" accept="image/jpeg,image/png,image/webp,image/avif">
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="materialsUpload">Material-Bild (Leistungen) ersetzen</label>
            <input id="materialsUpload" name="materials" type="file" accept="image/jpeg,image/png,image/webp,image/avif">
          </div>
          <div class="field">
            <label for="calculatorUpload">Rechner-Bild ersetzen</label>
            <input id="calculatorUpload" name="calculator" type="file" accept="image/jpeg,image/png,image/webp,image/avif">
          </div>
        </div>
        <div class="field">
          <label for="galleryUpload">Galeriebilder ergänzen (max. 8 insgesamt)</label>
          <input id="galleryUpload" name="gallery" type="file" accept="image/jpeg,image/png,image/webp,image/avif" multiple>
          <span class="hint">Hochgeladene Bilder werden an die vorhandene eigene Galerie angehängt.</span>
        </div>
        <label class="checkbox">
          <input type="checkbox" name="replaceGallery" value="1">
          <span>Vorhandene eigene Galerie vor dem Hochladen entfernen</span>
        </label>
        <label class="checkbox">
          <input type="checkbox" name="resetGallery" value="1">
          <span>Galerie auf die mitgelieferten Bilder zurücksetzen (ohne neue Uploads)</span>
        </label>
        <div class="form-actions">
          <button class="btn" type="submit">Bilder speichern</button>
        </div>
      </form>
    </noscript>

    <dialog class="admin-modal" data-image-modal aria-labelledby="image-modal-title">
      <form method="post" action="/admin/stammdaten/bilder/" enctype="multipart/form-data" class="admin-modal-form" data-image-modal-form>
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <input type="hidden" name="slot" value="" data-image-slot>
        <div class="admin-modal-head">
          <h2 id="image-modal-title" data-image-modal-title>Bild bearbeiten</h2>
          <button type="button" class="admin-modal-close" data-modal-close aria-label="Schließen">&times;</button>
        </div>
        <div class="admin-dropzone" data-dropzone tabindex="0" role="button">
          <input type="file" data-file-input accept="image/*" hidden>
          <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0 4 5m-4-5-4 5M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg>
          <p data-drop-text>Bild hierher ziehen oder klicken zum Auswählen</p>
          <p class="hint"><span data-accept-label>JPG, PNG, WebP oder AVIF</span> &middot; max. <span data-max-label>12 MB</span></p>
        </div>
        <div class="admin-selection" data-selection hidden></div>
        <div class="admin-crop" data-crop hidden>
          <div class="admin-crop-head">
            <span class="text-muted" data-crop-name></span>
            <button type="button" class="btn btn-secondary btn-small" data-crop-clear>Anderes Bild</button>
          </div>
          <div class="admin-crop-stage" data-crop-stage>
            <img data-crop-image alt="Vorschau mit Zuschnitt">
            <div class="admin-crop-box" data-crop-box>
              <span class="admin-crop-handle" data-crop-handle="nw"></span>
              <span class="admin-crop-handle" data-crop-handle="ne"></span>
              <span class="admin-crop-handle" data-crop-handle="sw"></span>
              <span class="admin-crop-handle" data-crop-handle="se"></span>
            </div>
          </div>
          <div class="admin-crop-actions">
            <button type="button" class="btn btn-secondary btn-small" data-crop-reset>Ausschnitt zurücksetzen</button>
            <span class="hint">Ziehen zum Verschieben, an den Ecken ziehen zum Verkleinern.</span>
          </div>
        </div>
        <div class="alert alert-danger" data-modal-error hidden role="alert"><p></p></div>
        <div class="upload-progress" data-upload-progress hidden>
          <progress max="100" value="0" data-upload-bar></progress>
          <p class="upload-status" data-upload-status aria-live="polite"></p>
        </div>
        <div class="admin-modal-actions">
          <button type="button" class="btn btn-secondary" data-modal-close>Abbrechen</button>
          <button type="submit" class="btn" data-modal-save>Speichern</button>
        </div>
      </form>
    </dialog>

    <dialog class="admin-modal" data-gallery-modal aria-labelledby="gallery-modal-title">
      <form method="post" action="/admin/stammdaten/bilder/" enctype="multipart/form-data" class="admin-modal-form" data-gallery-form>
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <input type="hidden" name="slot" value="gallery">
        <div class="admin-modal-head">
          <h2 id="gallery-modal-title">Galeriebilder bearbeiten</h2>
          <button type="button" class="admin-modal-close" data-modal-close aria-label="Schließen">&times;</button>
        </div>
        <div class="admin-dropzone" data-gallery-dropzone tabindex="0" role="button">
          <input type="file" data-gallery-input accept="image/jpeg,image/png,image/webp,image/avif" multiple hidden>
          <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0 4 5m-4-5-4 5M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg>
          <p>Mehrere Bilder hierher ziehen oder klicken zum Auswählen</p>
          <p class="hint">JPG, PNG, WebP oder AVIF &middot; max. 12 MB pro Bild</p>
        </div>
        <div class="admin-selection-head" data-selection-head hidden>
          <p class="text-muted" data-selection-count></p>
          <button type="button" class="btn btn-secondary btn-small" data-clear-selection>Alle entfernen</button>
        </div>
        <div class="admin-selection admin-selection-grid" data-gallery-selection hidden></div>
        <label class="checkbox" data-replace-wrapper>
          <input type="checkbox" name="replaceGallery" value="1" data-replace-gallery>
          <span>Vorhandene eigene Galerie vor dem Hochladen entfernen</span>
        </label>
        <div class="alert alert-danger" data-modal-error hidden role="alert"><p></p></div>
        <div class="upload-progress" data-upload-progress hidden>
          <progress max="100" value="0" data-upload-bar></progress>
          <p class="upload-status" data-upload-status aria-live="polite"></p>
        </div>
        <div class="admin-modal-actions">
          <button type="button" class="btn btn-secondary" data-modal-close>Abbrechen</button>
          <button type="submit" class="btn" data-modal-save>Speichern</button>
        </div>
      </form>
    </dialog>
      </div>
    </details>
  </section>

  <form class="form card admin-panel" method="post" action="/admin/stammdaten/texte/">
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    <details class="admin-field-collapse" data-collapse="site-texts">
      <summary>
        <h2>Texte auf der Startseite</h2>
        <span class="admin-collapse-preview">{{ content['home.hero.title'] or 'Noch kein Text hinterlegt' }}</span>
      </summary>
      <div class="admin-collapse-body">
    <div class="field">
      <label for="heroKicker">Kicker (Hero)</label>
      <input id="heroKicker" name="heroKicker" type="text" maxlength="120" value="{{ content['home.hero.kicker'] }}">
    </div>
    <div class="field">
      <label for="heroTitle">Überschrift (Hero)</label>
      <input id="heroTitle" name="heroTitle" type="text" maxlength="200" value="{{ content['home.hero.title'] }}">
    </div>
    <div class="field">
      <label for="heroText">Einleitungstext (Hero)</label>
      <textarea id="heroText" name="heroText" rows="3" maxlength="600">{{ content['home.hero.text'] }}</textarea>
    </div>
    <div class="field">
      <label for="contactTitle">Überschrift Kontaktbereich</label>
      <input id="contactTitle" name="contactTitle" type="text" maxlength="200" value="{{ content['home.contact.title'] }}">
    </div>
    <div class="field">
      <label for="contactText">Text Kontaktbereich</label>
      <textarea id="contactText" name="contactText" rows="3" maxlength="600">{{ content['home.contact.text'] }}</textarea>
    </div>
      </div>
    </details>
    <div class="form-actions">
      <button class="btn" type="submit">Texte speichern</button>
