{% extends "layouts/admin.njk" %}
{% from "admin/partials/icons.njk" import icon %}

{% block title %}Veröffentlichung – 3D-MIR Admin{% endblock %}

{% block content %}
  <div class="admin-page-head">
    <div>
      <h1>Veröffentlichung</h1>
      <p>Platzhalter-Hinweise ausblenden, sobald Preise, Versand und Rechtstexte geprüft sind.</p>
    </div>
  </div>

  {% if meldung.gespeichert %}
    <div class="alert alert-success" role="status"><p>Die Einstellungen wurden gespeichert.</p></div>
  {% endif %}

  <div class="alert alert-warning" role="status">
    <p><strong>Bitte erst nach fachlicher Prüfung umschalten.</strong> Die Hinweise verschwinden sofort auf der ganzen Website. Preise und Versandkosten müssen vorher bestätigt sein; die Rechtstexte sollten rechtlich geprüft sein.</p>
    <p>Außerhalb dieser Software vor dem Livegang klären: anwaltliche Prüfung der Rechtstexte sowie die steuerliche Aufbewahrungsfrist. Die LUCID-Registrierung und Systembeteiligung sind bereits erledigt.</p>
  </div>

  <form class="form card" method="post" action="/admin/veroeffentlichung/">
    <input type="hidden" name="_csrf" value="{{ csrf }}">

    <fieldset class="admin-fieldset">
      <legend>Shop und Preise</legend>

      <label class="checkbox">
        <input type="checkbox" name="shopLive" value="1" {% if publication.shopStatus == 'AKTIV' %}checked{% endif %}>
        <span><strong>Shop ist live</strong> – Hinweis „Der Shop befindet sich im Aufbau …“ auf Shop-, Produkt-, Warenkorb- und Kassenseite ausblenden.</span>
      </label>

      <label class="checkbox">
        <input type="checkbox" name="pricingFinal" value="1" {% if publication.pricingStatus == 'FINAL' %}checked{% endif %}>
        <span><strong>Preise und Kalkulation sind bestätigt</strong> – Platzhalter-Warnung im Admin-Bereich „Preise“ ausblenden.</span>
      </label>

      <label class="checkbox">
        <input type="checkbox" name="shippingFinal" value="1" {% if publication.shippingStatus == 'FINAL' %}checked{% endif %}>
        <span><strong>Versandkosten und Lieferzeiten sind bestätigt</strong> – Hinweis auf der Seite „Versandarten und Kosten“ ausblenden.</span>
      </label>
    </fieldset>

    <fieldset class="admin-fieldset">
      <legend>Rechtstexte</legend>

      <label class="checkbox">
        <input type="checkbox" name="showLegalDraftNotice" value="1" {% if publication.showLegalDraftNotice %}checked{% endif %}>
        <span><strong>Entwurfshinweis anzeigen</strong> – Hinweis „Dieser Text … ist vor der Veröffentlichung rechtlich zu prüfen“ auf Impressum, AGB, Datenschutz, Widerruf, Versand und Zahlung anzeigen. Erst abwählen, wenn die Texte geprüft sind.</span>
      </label>

      <p class="hint">Gelb markierte TODO-Platzhalter in den Rechtstexten (Hosting, SMTP, Versand, Löschfrist) unter <a href="/admin/rechtstexte/">Rechtstexte</a> ausfüllen.</p>
    </fieldset>

    <div class="form-actions">
      <button class="btn" type="submit">Einstellungen speichern</button>
    </div>
  </form>

  <section class="card admin-panel">
    <div class="admin-panel-head">
      <h2>To-do bis zum Livegang</h2>
      <span class="badge badge-{% if checklistDone == checklist.length and checklist.length > 0 %}success{% else %}info{% endif %}">
        {{ checklistDone }} von {{ checklist.length }} erledigt
      </span>
    </div>
    <p class="text-muted">Die Liste enthält die offenen Punkte aus der Abnahme. Abhaken, löschen und eigene Punkte ergänzen – der Stand bleibt im Admin gespeichert.</p>

    {% if checklist.length > 0 %}
      <ul class="admin-checklist">
        {% for item in checklist %}
          <li class="{% if item.done %}is-done{% endif %}" data-checklist-item="{{ item.id }}">
            <form class="admin-checklist-item" method="post" action="/admin/veroeffentlichung/checkliste/">
              <input type="hidden" name="_csrf" value="{{ csrf }}">
              <input type="hidden" name="action" value="toggle">
              <input type="hidden" name="id" value="{{ item.id }}">
              <label class="admin-check">
                <input type="checkbox" name="done" value="1" {% if item.done %}checked{% endif %} data-checklist-toggle>
                <span>{{ item.text }}</span>
              </label>
              <button class="admin-icon-btn admin-icon-btn--success" type="submit" data-tooltip="Übernehmen" aria-label="Punkt „{{ item.text }}“ übernehmen">{{ icon('check') }}</button>
            </form>
            <form method="post" action="/admin/veroeffentlichung/checkliste/" data-confirm="Diesen Punkt wirklich löschen?">
              <input type="hidden" name="_csrf" value="{{ csrf }}">
              <input type="hidden" name="action" value="remove">
              <input type="hidden" name="id" value="{{ item.id }}">
              <button class="admin-icon-btn admin-icon-btn--danger" type="submit" data-tooltip="Löschen" aria-label="Punkt „{{ item.text }}“ löschen">{{ icon('trash') }}</button>
            </form>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="text-muted">Aktuell sind keine Punkte hinterlegt. Ergänze unten einen neuen Punkt oder stelle die Standardliste wieder her.</p>
    {% endif %}

    <form class="admin-checklist-add" method="post" action="/admin/veroeffentlichung/checkliste/">
      <input type="hidden" name="_csrf" value="{{ csrf }}">
      <input type="hidden" name="action" value="add">
      <div class="field">
        <label for="newChecklistItem">Neuer Punkt</label>
        <input id="newChecklistItem" name="text" type="text" maxlength="200" required placeholder="z. B. Live-Testbestellung prüfen">
      </div>
      <button class="btn btn-small" type="submit">Hinzufügen</button>
    </form>

    <form class="admin-checklist-reset" method="post" action="/admin/veroeffentlichung/checkliste/" data-confirm="Die aktuelle Liste durch die Standardliste ersetzen? Eigene Punkte gehen verloren.">
      <input type="hidden" name="_csrf" value="{{ csrf }}">
      <input type="hidden" name="action" value="reset">
      <button class="btn btn-secondary btn-small" type="submit">Standardliste wiederherstellen</button>
    </form>
  </section>
{% endblock %}
