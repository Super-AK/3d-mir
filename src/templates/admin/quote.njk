{% extends "layouts/admin.njk" %}

{% block title %}Anfrage {{ quote.reference }} – 3D-MIR Admin{% endblock %}

{% block content %}
  <nav class="breadcrumb" aria-label="Brotkrumen">
    <ol><li><a href="/admin/anfragen/">Anfragen</a></li><li aria-current="page">{{ quote.reference }}</li></ol>
  </nav>

  <div class="admin-page-head">
    <div>
      <h1>Anfrage {{ quote.reference }}</h1>
      <p>Eingegangen am {{ quote.created_at | date }} · zuletzt geändert am {{ quote.updated_at | date }}</p>
    </div>
    <div class="admin-page-actions">
      {% if quote.status == 'neu' %}<span class="badge badge-warning">Neu</span>
      {% elif quote.status == 'geprueft' %}<span class="badge badge-info">Geprüft</span>
      {% elif quote.status == 'angebot_gesendet' %}<span class="badge badge-info">Angebot gesendet</span>
      {% elif quote.status == 'angenommen' %}<span class="badge badge-success">Angenommen</span>
      {% elif quote.status == 'abgelehnt' %}<span class="badge badge-danger">Abgelehnt</span>
      {% else %}<span class="badge badge-neutral">Abgeschlossen</span>{% endif %}
    </div>
  </div>

  <div class="admin-grid-2 admin-grid-wide">
    <section class="card admin-panel">
      <h2>Kontakt</h2>
      <dl class="admin-dl">
        <div><dt>Name</dt><dd>{{ quote.name }}</dd></div>
        {% if quote.company %}<div><dt>Firma</dt><dd>{{ quote.company }}</dd></div>{% endif %}
        <div><dt>E-Mail</dt><dd><a href="mailto:{{ quote.email }}">{{ quote.email }}</a></dd></div>
        <div><dt>Telefon</dt><dd>{{ quote.phone or '–' }}</dd></div>
        <div><dt>Nachricht</dt><dd>{{ quote.message or '–' }}</dd></div>
      </dl>

      <h2 class="mt-2">Modell und Kalkulation</h2>
      <dl class="admin-dl">
        <div><dt>Material</dt><dd>{{ materialLabel }}{% if quote.color %} · {{ quote.color }}{% endif %}</dd></div>
        <div><dt>Drucker</dt><dd>{{ printerLabel }}</dd></div>
        <div><dt>Füllgrad</dt><dd>{{ quote.infill }} %</dd></div>
        <div><dt>Schichthöhe</dt><dd>{{ quote.layer_height }} mm</dd></div>
        <div><dt>Stückzahl</dt><dd>{{ quote.quantity }}</dd></div>
        <div><dt>Nachbearbeitung</dt><dd>{{ coatingLabel }}</dd></div>
        <div><dt>Skalierung</dt><dd>{{ quote.scale_percent }} %</dd></div>
        <div><dt>Volumen</dt><dd>{{ quote.volume_cm3 | number(2) }} cm³</dd></div>
        <div><dt>Oberfläche</dt><dd>{{ quote.surface_cm2 | number(2) }} cm²</dd></div>
        <div><dt>Gewicht</dt><dd>{{ quote.weight_g | number(1) }} g</dd></div>
        <div><dt>Preisschätzung</dt><dd><strong>{{ quote.estimated_price_cents | price }}</strong></dd></div>
        <div><dt>Einwilligung</dt><dd>{{ quote.consent_at | date }}</dd></div>
      </dl>

      <h2 class="mt-2">Modell-Datei</h2>
      {% if quote.file_path %}
        <dl class="admin-dl">
          <div><dt>Dateiname</dt><dd>{{ quote.file_name }}</dd></div>
          <div><dt>Größe</dt><dd>{{ quote.file_size }} Bytes</dd></div>
          <div><dt>SHA-256</dt><dd><code class="admin-code">{{ quote.file_sha256 }}</code></dd></div>
        </dl>
        <a class="btn btn-small" href="/admin/anfragen/{{ quote.id }}/datei/">Datei herunterladen</a>
      {% else %}
        <p class="text-muted">Keine Datei gespeichert.</p>
      {% endif %}
    </section>

    <section class="card admin-panel">
      <h2>Bearbeiten</h2>
      <form class="form" method="post" action="/admin/anfragen/{{ quote.id }}/">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <div class="field">
          <label for="status">Status</label>
          <select id="status" name="status">
            {% for item in statuses %}
              <option value="{{ item.id }}" {% if quote.status == item.id %}selected{% endif %}>{{ item.label }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="field">
          <label for="adminNote">Interne Notiz</label>
          <textarea id="adminNote" name="adminNote" rows="5" maxlength="2000">{{ quote.admin_note }}</textarea>
          <span class="hint">Nur im Admin-Bereich sichtbar.</span>
        </div>
        <label class="admin-check">
          <input type="checkbox" name="notify" value="1">
          <span>Kunden bei Statusänderung per E-Mail informieren</span>
        </label>
        <div class="form-actions">
          <button class="btn" type="submit">Speichern</button>
          <a class="btn btn-secondary" href="/admin/anfragen/">Zurück</a>
        </div>
      </form>

      <h2 class="mt-2">Statusverlauf</h2>
      {% if history.length > 0 %}
        <ul class="admin-history">
          {% for entry in history %}
            <li>
              <strong>{{ entry.from_status or '–' }} → {{ entry.to_status }}</strong>
              <small class="text-muted">{{ entry.created_at | date }} · {{ entry.actor }}</small>
              {% if entry.note %}<span>{{ entry.note }}</span>{% endif %}
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="text-muted">Noch keine Statusänderung protokolliert.</p>
      {% endif %}

      <h2 class="mt-2">Löschen</h2>
      <p class="text-muted">Löscht die Anfrage, alle Angaben und die hochgeladene Datei endgültig.</p>
      <a class="btn btn-danger btn-small" href="/admin/anfragen/{{ quote.id }}/loeschen/">Anfrage löschen</a>
    </section>
  </div>
{% endblock %}
