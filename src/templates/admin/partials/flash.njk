{% if error %}
  <div class="alert alert-danger" role="alert"><p>{{ error }}</p></div>
{% endif %}
{% if meldung and meldung.fehler %}
  <div class="alert alert-danger" role="alert"><p>{{ meldung.fehler }}</p></div>
{% endif %}
{% if meldung and meldung.gespeichert %}
  <div class="alert alert-success" role="status"><p>{% if meldung.anzahl %}{{ meldung.anzahl }} Nachricht(en) wurden aktualisiert.{% else %}Änderungen wurden gespeichert.{% endif %}</p></div>
{% endif %}
{% if meldung and meldung.geloescht %}
  <div class="alert alert-success" role="status"><p>{% if meldung.anzahl %}{{ meldung.anzahl }} Nachricht(en) wurden gelöscht.{% else %}Der Eintrag wurde gelöscht.{% endif %}</p></div>
{% endif %}
{% if meldung and meldung.sortiert %}
  <div class="alert alert-success" role="status"><p>Die Sortierung wurde gespeichert.</p></div>
{% endif %}
{% if meldung and meldung.zurueckgesetzt %}
  <div class="alert alert-success" role="status"><p>Die Preise wurden auf die Grundeinstellung zurückgesetzt.</p></div>
{% endif %}
{% if meldung and meldung.importiert > 0 %}
  <div class="alert alert-success" role="status"><p>{{ meldung.importiert }} Produkt(e) wurden importiert oder aktualisiert.</p></div>
{% endif %}
