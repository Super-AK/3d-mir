{% extends "layouts/admin.njk" %}

{% block title %}Dashboard – 3D-MIR Admin{% endblock %}

{% block content %}
  <div class="admin-page-head">
    <div>
      <h1>Dashboard</h1>
      <p>Überblick über Bestellungen, Anfragen, Nachrichten und Besucher.</p>
    </div>
    <div class="admin-page-actions">
      <a class="btn btn-small" href="/admin/bestellungen/">Bestellungen</a>
      <a class="btn btn-secondary btn-small" href="/admin/anfragen/">Anfragen</a>
    </div>
  </div>

  <div class="admin-stats">
    <a class="admin-stat card card-hover" href="/admin/bestellungen/?status=offen">
      <span class="admin-stat-label">Offene Bestellungen</span>
      <strong>{{ openOrders }}</strong>
      <span class="admin-stat-note">{{ counts.neu or 0 }} neu · {{ counts.bezahlt or 0 }} bezahlt · {{ counts.in_druck or 0 }} im Druck</span>
    </a>
    <a class="admin-stat card card-hover" href="/admin/bestellungen/?paymentStatus=offen">
      <span class="admin-stat-label">Offene Zahlungen</span>
      <strong>{{ openPayments }}</strong>
      <span class="admin-stat-note">Vorkasse oder Online-Zahlung ausstehend</span>
    </a>
    <a class="admin-stat card card-hover" href="/admin/anfragen/?status=neu">
      <span class="admin-stat-label">Neue Anfragen</span>
      <strong>{{ newQuotes }}</strong>
      <span class="admin-stat-note">Angebotsanfragen aus dem Rechner</span>
    </a>
    <a class="admin-stat card card-hover" href="/admin/nachrichten/">
      <span class="admin-stat-label">Offene Nachrichten</span>
      <strong>{{ openMessages }}</strong>
      <span class="admin-stat-note">Kontaktformular</span>
    </a>
    <a class="admin-stat card card-hover" href="/admin/besucherstatistik/">
      <span class="admin-stat-label">Aufrufe heute</span>
      <strong>{{ visitorStats.todayViews }}</strong>
      <span class="admin-stat-note">{{ visitorStats.weekViews }} Aufrufe in 7 Tagen</span>
    </a>
    <a class="admin-stat card card-hover" href="/admin/besucherstatistik/">
      <span class="admin-stat-label">Besucher heute</span>
      <strong>{{ visitorStats.todayVisitors }}</strong>
      <span class="admin-stat-note">täglich eindeutig, ohne Cookies</span>
    </a>
    <div class="admin-stat card">
      <span class="admin-stat-label">Erfasster Umsatz</span>
      <strong>{{ revenue | price }}</strong>
      <span class="admin-stat-note">Bezahlte, gedruckte, versandte und abgeschlossene Bestellungen</span>
    </div>
  </div>

  <section class="card admin-panel admin-visitor-panel">
    <details class="admin-field-collapse" data-collapse="dashboard-visitors">
      <summary>
        <h2>Besucher der letzten 7 Tage</h2>
        <span class="admin-collapse-preview">{{ visitorStats.weekViews }} Aufrufe · {{ visitorStats.weekVisitors }} Besucher</span>
      </summary>
      <div class="admin-collapse-body">
        {% if visitorStats.hasData %}
          <p class="text-muted">{{ visitorStats.weekViews }} Aufrufe · {{ visitorStats.weekVisitors }} Besucher (täglich eindeutig) · heute {{ visitorStats.todayViews }} Aufrufe</p>
          <div class="admin-visitor-bars">
            {% for item in visitorStats.series %}
              <div class="admin-visitor-bar">
                <span>{{ item.label }}</span>
                <span class="admin-visitor-bar-track"><span class="admin-visitor-bar-fill" style="width: {{ item.percent }}%"></span></span>
                <span class="admin-visitor-bar-value">{{ item.views }} Aufrufe</span>
              </div>
            {% endfor %}
          </div>
          {% if visitorStats.countries.length > 0 %}
            <p class="admin-visitor-countries">Häufigste Länder: {% for country in visitorStats.countries %}{{ country.name }} ({{ country.views }}){% if not loop.last %} · {% endif %}{% endfor %}</p>
          {% endif %}
        {% else %}
          <p class="text-muted">Noch keine Besucherdaten vorhanden. Gezählt wird ab dem ersten Aufruf.</p>
        {% endif %}
        <p><a href="/admin/besucherstatistik/">Auswertung öffnen</a></p>
      </div>
    </details>
  </section>

  <section class="card admin-panel admin-monitor-panel">
    <details class="admin-field-collapse" data-collapse="dashboard-monitor">
      <summary>
        <h2>Systemstatus</h2>
        {% if not monitor.available %}
          <span class="badge badge-neutral">noch keine Prüfung</span>
        {% elif monitor.down %}
          <span class="badge badge-danger">Störung erkannt</span>
        {% else %}
          <span class="badge badge-success">erreichbar</span>
        {% endif %}
        <span class="admin-collapse-preview">{{ (monitor.lastCheck | datetime) or 'Details anzeigen' }}</span>
      </summary>
      <div class="admin-collapse-body">
        {% if monitor.available %}
          <dl class="admin-dl">
            <div><dt>Letzte Prüfung</dt><dd>{{ (monitor.lastCheck | datetime) or 'unbekannt' }}</dd></div>
            <div><dt>Letzte erfolgreiche Prüfung</dt><dd>{{ (monitor.lastOk | datetime) or '–' }}</dd></div>
            {% if monitor.down %}
              <div><dt>Ausfall seit</dt><dd>{{ (monitor.since | datetime) or 'unbekannt' }}</dd></div>
              <div><dt>Letzte Warnung</dt><dd>{{ (monitor.lastAlert | datetime) or '–' }}</dd></div>
            {% endif %}
            <div><dt>Details</dt><dd>{{ monitor.detail or '–' }}</dd></div>
          </dl>
        {% else %}
          <p class="text-muted">Noch keine Statusdatei vorhanden. Der Uptime-Check läuft alle fünf Minuten über <code>3d-mir-monitor.timer</code>.</p>
        {% endif %}
        <div class="admin-page-actions">
          <a class="btn btn-secondary btn-small" href="/admin/">Status aktualisieren</a>
          <a class="btn btn-secondary btn-small" href="/admin/benachrichtigungen/">Benachrichtigungen</a>
        </div>
      </div>
    </details>
  </section>

  <div class="admin-grid-2">
    <section class="card admin-panel">
      <div class="admin-panel-head">
        <h2>Letzte Bestellungen</h2>
        <a href="/admin/bestellungen/">Alle anzeigen</a>
      </div>
      {% if recentOrders.length > 0 %}
        <div class="table-wrap">
          <table>
            <thead><tr><th>Nummer</th><th>Kunde</th><th>Status</th><th>Gesamt</th></tr></thead>
            <tbody>
              {% for order in recentOrders %}
                <tr>
                  <td><a href="/admin/bestellungen/{{ order.id }}/">{{ order.order_number }}</a><br><small class="text-muted">{{ order.created_at | date }}</small></td>
                  <td>{{ order.first_name }} {{ order.last_name }}</td>
                  <td><span class="badge badge-neutral">{{ order.status }}</span><br><span class="badge badge-{{ order.paymentStatusTone }}">{{ order.paymentStatusText }}</span></td>
                  <td>{{ order.total_cents | price }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <p class="text-muted">Noch keine Bestellungen.</p>
      {% endif %}
    </section>

    <section class="card admin-panel">
      <div class="admin-panel-head">
        <h2>Letzte Anfragen</h2>
        <a href="/admin/anfragen/">Alle anzeigen</a>
      </div>
      {% if recentQuotes.length > 0 %}
        <ul class="admin-list">
          {% for quote in recentQuotes %}
            <li>
              <a href="/admin/anfragen/{{ quote.id }}/">{{ quote.reference }}</a>
              <span>{{ quote.name }}</span>
              <small class="text-muted">{{ quote.created_at | date }} · {{ quote.estimated_price_cents | price }}</small>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="text-muted">Noch keine Anfragen.</p>
      {% endif %}
    </section>
  </div>

  <section class="card admin-panel">
    <div class="admin-panel-head">
      <h2>Letzte Nachrichten</h2>
      <a href="/admin/nachrichten/">Alle anzeigen</a>
    </div>
    {% if recentMessages.length > 0 %}
      <ul class="admin-list">
        {% for message in recentMessages %}
          <li>
            <a href="/admin/nachrichten/{{ message.id }}/">{{ message.subject or 'Kontaktnachricht' }}</a>
            <span>{{ message.name }}</span>
            <small class="text-muted">{{ message.created_at | date }}{% if message.handled %} · erledigt{% endif %}</small>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="text-muted">Noch keine Nachrichten.</p>
    {% endif %}
  </section>
{% endblock %}
