{% extends "layouts/admin.njk" %}
{% from "admin/partials/icons.njk" import icon %}

{% block title %}Produkte – 3D-MIR Admin{% endblock %}

{% block content %}
  <div class="admin-page-head">
    <div>
      <h1>Produkte</h1>
      <p>Produkte, Preise, Varianten, Farben, Personalisierung und Bilder pflegen, kopieren sowie exportieren/importieren.</p>
    </div>
    <div class="admin-page-actions">
      <a class="btn btn-small" href="/admin/produkte/neu/">Neues Produkt</a>
      <a class="btn btn-secondary btn-small" href="/admin/produkte/import/">Importieren</a>
      <a class="btn btn-secondary btn-small" href="/admin/produkte/etsy/">Aus Etsy importieren</a>
      <a class="btn btn-secondary btn-small" href="/admin/produkte/export/">Exportieren</a>
    </div>
  </div>

  <form class="admin-filter card" method="get" action="/admin/produkte/">
    <div class="field">
      <label for="q">Suche</label>
      <input id="q" name="q" type="search" value="{{ q }}" placeholder="Name, SKU oder Slug" data-live-search>
    </div>
    <div class="admin-filter-actions">
      <button class="btn btn-small" type="submit" data-filter-submit>Filtern</button>
      <a class="btn btn-secondary btn-small" href="/admin/produkte/">Zurücksetzen</a>
    </div>
  </form>
  <p class="hint">Die Suche aktualisiert die Ansicht sofort beim Tippen. Bei aktivem JavaScript entfällt der Button „Filtern“.</p>

  <div data-filter-results>
    <p class="text-muted">{{ products.length }} Produkt(e) in dieser Ansicht.</p>

    {% if products.length > 0 %}
      <form id="bulk-delete-form" method="post" action="/admin/produkte/massenloeschen/">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
      </form>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th class="admin-check-cell"><input type="checkbox" data-select-all aria-label="Alle Produkte auswählen"></th>
              <th>Produkt</th>
              <th>Slug</th>
              <th>Preis</th>
              <th>Varianten</th>
              <th>Lager</th>
              <th>Status</th>
              <th>Aktionen</th>
            </tr>
          </thead>
          <tbody>
            {% for product in products %}
              <tr>
                <td class="admin-check-cell">
                  <input type="checkbox" name="ids" value="{{ product.id }}" form="bulk-delete-form" data-select-product aria-label="Produkt {{ product.name }} auswählen">
                </td>
                <td><a href="/admin/produkte/{{ product.id }}/"><strong>{{ product.name }}</strong></a><br><small class="text-muted">{{ product.sku or 'ohne SKU' }}</small></td>
                <td><code class="admin-code">{{ product.slug }}</code></td>
                <td>{{ product.priceLabel }}</td>
                <td>{{ product.variant_count }}</td>
                <td><span class="{% if product.stockEmpty %}text-muted{% endif %}">{{ product.stockLabel }}</span></td>
                <td>{% if product.active %}<span class="badge badge-success">Aktiv</span>{% else %}<span class="badge badge-neutral">Inaktiv</span>{% endif %}</td>
                <td>
                  <div class="admin-icon-actions">
                    <form method="post" action="/admin/produkte/{{ product.id }}/kopieren/">
                      <input type="hidden" name="_csrf" value="{{ csrf }}">
                      <button class="admin-icon-btn" type="submit" data-tooltip="Kopieren" aria-label="Produkt {{ product.name }} kopieren">{{ icon('copy') }}</button>
                    </form>
                    <a class="admin-icon-btn" href="/admin/produkte/{{ product.id }}/export/" data-tooltip="Export" aria-label="Produkt {{ product.name }} exportieren">{{ icon('download') }}</a>
                    <a class="admin-icon-btn admin-icon-btn--danger" href="/admin/produkte/{{ product.id }}/loeschen/" data-tooltip="Löschen" aria-label="Produkt {{ product.name }} löschen">{{ icon('trash') }}</a>
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <div class="admin-bulk-actions">
        <label class="admin-check admin-check-inline">
          <input type="checkbox" data-select-all aria-label="Alle Produkte auswählen">
          <span>Alle auswählen</span>
        </label>
        <button class="btn btn-danger btn-small" type="submit" form="bulk-delete-form">Ausgewählte löschen</button>
      </div>
      <p class="hint">Beim Löschen werden Varianten und Bilder entfernt; bestehende Bestellungen bleiben mit ihren Positionsdaten erhalten. Kopien werden zunächst inaktiv angelegt.</p>
    {% else %}
      <div class="card empty-state">
        {% if q %}
          <h2>Keine Produkte gefunden</h2>
          <p class="text-muted">Für „{{ q }}“ gibt es keine Treffer. Versuchen Sie einen anderen Namen, eine andere SKU oder einen anderen Slug.</p>
          <div class="form-actions">
            <a class="btn btn-secondary" href="/admin/produkte/">Suche zurücksetzen</a>
          </div>
        {% else %}
          <h2>Noch keine Produkte</h2>
          <p class="text-muted">Legen Sie das erste Produkt an oder importieren Sie eine JSON-Datei.</p>
          <div class="form-actions">
            <a class="btn" href="/admin/produkte/neu/">Neues Produkt</a>
            <a class="btn btn-secondary" href="/admin/produkte/import/">Importieren</a>
            <a class="btn btn-secondary" href="/admin/produkte/etsy/">Aus Etsy importieren</a>
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
{% endblock %}
