{% extends "layouts/admin.njk" %}

{% block title %}Passwort ändern – 3D-MIR Admin{% endblock %}

{% block content %}
  <div class="admin-page-head">
    <div>
      <h1>Passwort ändern</h1>
      <p>Das Passwort gilt für {{ admin.email }}. Andere Sitzungen werden dabei abgemeldet.</p>
    </div>
  </div>

  <form class="form card admin-panel admin-panel-narrow" method="post" action="/admin/passwort/">
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    <div class="field">
      <label for="currentPassword">Aktuelles Passwort</label>
      <input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required>
    </div>
    <div class="field">
      <label for="newPassword">Neues Passwort</label>
      <input id="newPassword" name="newPassword" type="password" autocomplete="new-password" minlength="12" required>
      <span class="hint">Mindestens 12 Zeichen. Bitte einen Passwort-Manager verwenden.</span>
    </div>
    <div class="field">
      <label for="repeatPassword">Neues Passwort wiederholen</label>
      <input id="repeatPassword" name="repeatPassword" type="password" autocomplete="new-password" minlength="12" required>
    </div>
    <div class="form-actions">
      <button class="btn" type="submit">Passwort ändern</button>
      <a class="btn btn-secondary" href="/admin/">Zurück</a>
    </div>
  </form>

  <section class="card admin-panel mt-2">
    <h2>Zwei-Faktor-Authentifizierung (TOTP)</h2>
    {% if twoFactor.enabled %}
      <p><span class="badge badge-success">aktiv</span> Beim Anmelden wird zusätzlich ein 6-stelliger Code aus Ihrer Authenticator-App verlangt.</p>
      <form class="form" method="post" action="/admin/passwort/2fa/deaktivieren/">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <p class="text-muted">Zum Deaktivieren bestätigen Sie bitte Ihr aktuelles Passwort. Danach genügt wieder das Passwort allein.</p>
        <div class="field">
          <label for="disablePassword">Aktuelles Passwort</label>
          <input id="disablePassword" name="currentPassword" type="password" autocomplete="current-password" required>
        </div>
        <div class="form-actions">
          <button class="btn btn-danger" type="submit">2FA deaktivieren</button>
        </div>
      </form>
    {% elif twoFactor.setupPending %}
      <p>Scannen Sie diesen QR-Code mit einer Authenticator-App (z. B. Aegis, Google Authenticator, 1Password) und bestätigen Sie anschließend mit dem angezeigten Code.</p>
      <div class="admin-twofactor-setup">
        {% if twoFactor.qrDataUrl %}<img src="{{ twoFactor.qrDataUrl }}" alt="QR-Code für die Authenticator-App" width="220" height="220">{% endif %}
        <div>
          <p class="text-muted">Manueller Schlüssel:</p>
          <p><code class="admin-secret">{{ twoFactor.secret }}</code></p>
          <p class="hint">Bewahren Sie den Schlüssel sicher auf. Bei Verlust ist der Zugang nur noch über die Person möglich, die den Server verwaltet.</p>
        </div>
      </div>
      <form class="form" method="post" action="/admin/passwort/2fa/aktivieren/">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <div class="field">
          <label for="totpCode">Code aus der App</label>
          <input id="totpCode" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="8" required>
        </div>
        <div class="form-actions">
          <button class="btn" type="submit">2FA aktivieren</button>
        </div>
      </form>
      <form method="post" action="/admin/passwort/2fa/start/">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <button class="btn btn-secondary btn-small" type="submit">Neuen Schlüssel erzeugen</button>
      </form>
    {% else %}
      <p><span class="badge badge-warning">nicht aktiv</span> Schützen Sie die Anmeldung zusätzlich mit einem Einmalcode aus einer Authenticator-App.</p>
      <form method="post" action="/admin/passwort/2fa/start/">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <button class="btn" type="submit">2FA einrichten</button>
      </form>
    {% endif %}
  </section>

  <section class="card admin-panel mt-2">
    <h2>Passkeys</h2>
    <p class="text-muted">Passkeys ersetzen den 6-stelligen Code durch die Freigabe per Fingerabdruck, Gesichtserkennung, Windows Hello, Sicherheitsschlüssel oder Passwort-Manager. Sie können mehrere Geräte hinterlegen.</p>

    {% if passkeyCount > 0 %}
      <ul class="admin-passkey-list">
        {% for passkey in passkeys %}
          <li>
            <div>
              <strong>{{ passkey.label }}</strong>
              <span class="text-muted">Angelegt am {{ passkey.created_at }}{% if passkey.last_used_at %} · zuletzt verwendet {{ passkey.last_used_at }}{% endif %}</span>
            </div>
            <form method="post" action="/admin/passwort/passkey/loeschen/">
              <input type="hidden" name="_csrf" value="{{ csrf }}">
              <input type="hidden" name="id" value="{{ passkey.id }}">
              <button type="submit" class="btn btn-danger btn-small">Entfernen</button>
            </form>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p><span class="badge badge-warning">kein Passkey</span> Es ist noch kein Passkey hinterlegt.</p>
    {% endif %}

    <div class="field">
      <label for="passkeyLabel">Bezeichnung (optional)</label>
      <input id="passkeyLabel" type="text" maxlength="120" placeholder="z. B. iPhone oder Laptop" data-passkey-label>
    </div>
    <div class="form-actions">
      <button type="button" class="btn" data-passkey-add>Passkey hinzufügen</button>
    </div>
    <div class="alert alert-danger" data-passkey-error hidden role="alert"><p></p></div>
    <p class="hint">Passkeys funktionieren nur über HTTPS (oder localhost). Der private Schlüssel bleibt auf dem Gerät; auf dem Server wird nur der öffentliche Schlüssel gespeichert.</p>
  </section>
{% endblock %}
