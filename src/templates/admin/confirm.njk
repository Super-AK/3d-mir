{% extends "layouts/admin.njk" %}

{% block title %}{{ title }} – 3D-MIR Admin{% endblock %}

{% block content %}
  <div class="admin-page-head">
    <div>
      <h1>{{ title }}</h1>
      <p>{{ message }}</p>
    </div>
  </div>

  <form class="form card admin-panel admin-panel-narrow" method="post" action="{{ action }}">
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    <div class="form-actions">
      <button class="btn btn-danger" type="submit">Endgültig löschen</button>
      <a class="btn btn-secondary" href="{{ cancel }}">Abbrechen</a>
    </div>
  </form>
{% endblock %}
