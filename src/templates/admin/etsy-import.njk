{% extends "layouts/admin.njk" %}

{% block title %}Etsy-Import – 3D-MIR Admin{% endblock %}

{% block content %}
  <nav class="breadcrumb" aria-label="Brotkrumen">
    <ol><li><a href="/admin/produkte/">Produkte</a></li><li aria-current="page">Etsy-Import</li></ol>
  </nav>

  <div class="admin-page-head">
    <div>
      <h1>Produkte aus Etsy importieren</h1>
      <p>Listings per CSV-Export oder über die Etsy-API übernehmen. Vorhandene Produkte werden übersprungen.</p>
    </div>
    <div class="admin-page-actions">
      <a class="btn btn-secondary btn-small" href="/admin/produkte/">Zur Produktliste</a>
    </div>
  </div>

  {% if result %}
    <div class="alert {% if result.ok %}alert-success{% else %}alert-danger{% endif %}" role="status">
      <p>{% if result.ok %}Import abgeschlossen.{% else %}Import mit Fehlern beendet.{% endif %}</p>
    </div>
    <pre class="admin-import-log">{{ result.output }}</pre>
  {% elif importJob and importJob.output %}
    <div class="alert {% if importJob.running %}alert-info{% elif importJob.ok %}alert-success{% else %}alert-danger{% endif %}" role="status" data-etsy-import data-status-url="/admin/produkte/etsy/status/">
      <p>{% if importJob.running %}Import läuft … Die Ausgabe wird automatisch aktualisiert.{% elif importJob.ok %}Import abgeschlossen.{% else %}Import mit Fehlern beendet.{% endif %}</p>
    </div>
    <pre class="admin-import-log" id="etsy-import-log">{{ importJob.output }}</pre>
  {% endif %}

  <div class="admin-etsy-grid">
    <section class="card admin-panel">
      <h2>CSV-Export</h2>
      <p class="text-muted">In Etsy unter <strong>Shop Manager → Einstellungen → Optionen → Daten herunterladen</strong> bei „Currently for Sale Listings“ die CSV-Datei laden.</p>
      <form class="form" method="post" action="/admin/produkte/etsy/" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <input type="hidden" name="mode" value="csv">
        <div class="field">
          <label for="etsyCsv">CSV-Datei</label>
          <input id="etsyCsv" name="file" type="file" accept=".csv,text/csv" required>
        </div>
        <label class="checkbox">
          <input type="checkbox" name="dryRun" value="1" checked>
          <span>Nur Testlauf (nichts speichern)</span>
        </label>
        <div class="form-actions">
          <button class="btn" type="submit">CSV importieren</button>
        </div>
        <p class="hint">Der CSV-Export enthält keine Preise je Variationskombination. Der Import legt eine Standardvariante an und übernimmt die Varianten als Text in die Beschreibung.</p>
      </form>
    </section>

    <section class="card admin-panel">
      <h2>Etsy-API</h2>
      <p class="text-muted">Überträgt zusätzlich die exakten Variationen mit Preis und Bestand. Benötigt einen freigegebenen Etsy-Entwicklerzugang (Keystring und Shared Secret).</p>
      <form class="form" method="post" action="/admin/produkte/etsy/">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <input type="hidden" name="mode" value="api">
        <div class="field">
          <label for="etsyShop">Shopname</label>
          <input id="etsyShop" name="shop" type="text" maxlength="80" value="3DlMIR" required>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="etsyKey">Keystring</label>
            <input id="etsyKey" name="apiKey" type="text" maxlength="120" autocomplete="off" required>
          </div>
          <div class="field">
            <label for="etsySecret">Shared Secret</label>
            <input id="etsySecret" name="apiSecret" type="password" maxlength="120" autocomplete="off" required>
          </div>
        </div>
        <label class="checkbox">
          <input type="checkbox" name="dryRun" value="1" checked>
          <span>Nur Testlauf (nichts speichern)</span>
        </label>
        <div class="form-actions">
          <button class="btn" type="submit">Über API importieren</button>
        </div>
        <p class="hint">Die Zugangsdaten werden nur für diesen Import verwendet und nicht gespeichert. Solange die Etsy-App „Pending Personal Approval“ ist, lehnt Etsy die Anfrage ab.</p>
      </form>
    </section>
  </div>
{% endblock %}
