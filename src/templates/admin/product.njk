{% extends "layouts/admin.njk" %}
{% from "admin/partials/icons.njk" import icon %}

{% block title %}{% if isNew %}Neues Produkt{% else %}{{ product.name }}{% endif %} – 3D-MIR Admin{% endblock %}

{% block content %}
  <nav class="breadcrumb" aria-label="Brotkrumen">
    <ol><li><a href="/admin/produkte/">Produkte</a></li><li aria-current="page">{% if isNew %}Neues Produkt{% else %}{{ product.name }}{% endif %}</li></ol>
  </nav>

  <div class="admin-page-head">
    <div>
      <h1>{% if isNew %}Neues Produkt{% else %}{{ product.name }}{% endif %}</h1>
      <p>{% if isNew %}Produkt anlegen. Varianten, Farben und Personalisierung können anschließend ergänzt werden.{% else %}Produktdaten, Preise, Varianten, Farben und Personalisierung bearbeiten.{% endif %}</p>
    </div>
    {% if not isNew %}
      <div class="admin-page-actions">
        <a class="btn btn-secondary btn-small" href="/admin/produkte/{{ product.id }}/export/">JSON</a>
        <a class="btn btn-secondary btn-small" href="/admin/produkte/{{ product.id }}/csv/export/">CSV</a>
        <a class="btn btn-secondary btn-small" href="/shop/{{ product.slug }}/" target="_blank" rel="noopener">Im Shop ansehen</a>
      </div>
    {% endif %}
  </div>

  <form class="form card admin-panel" method="post" action="{% if isNew %}/admin/produkte/neu/{% else %}/admin/produkte/{{ product.id }}/{% endif %}">
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    <div class="form-row">
      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" maxlength="200" required value="{{ form.name }}">
      </div>
      <div class="field">
        <label for="slug">Slug</label>
        <input id="slug" name="slug" type="text" maxlength="120" pattern="[a-z0-9]+(-[a-z0-9]+)*" value="{{ form.slug }}" placeholder="wird aus dem Namen erzeugt">
        <span class="hint">Nur Kleinbuchstaben, Zahlen und Bindestriche. URL: /shop/&lt;slug&gt;/</span>
      </div>
    </div>

    <div class="field">
      <label for="shortDescription">Kurzbeschreibung</label>
      <textarea id="shortDescription" name="shortDescription" rows="2" maxlength="300">{{ form.shortDescription }}</textarea>
      <span class="hint">Erscheint in der Shop-Übersicht und in Suchmaschinen.</span>
    </div>

    <details class="admin-field-collapse">
      <summary>
        <span>Beschreibung</span>
        {% if form.description %}
          <span class="admin-collapse-preview">{{ form.description | truncate(90) }}</span>
        {% else %}
          <span class="admin-collapse-preview">Noch kein Text – klicken zum Bearbeiten</span>
        {% endif %}
      </summary>
      <div class="field admin-collapse-body">
        <label for="description">Beschreibung bearbeiten</label>
        <textarea id="description" name="description" rows="12" maxlength="10000">{{ form.description }}</textarea>
        <span class="hint">Leerzeilen erzeugen Absätze. HTML wird nicht ausgeführt.</span>
      </div>
    </details>

    <div class="form-row">
      <div class="field">
        <label for="material">Material</label>
        <input id="material" name="material" type="text" maxlength="100" value="{{ form.material }}" placeholder="z. B. PLA">
        <span class="hint">Erscheint auf der Produktseite als Materialangabe. Leer lassen für PLA.</span>
      </div>
      <div class="field">
        <label for="deliveryNote">Lieferhinweis</label>
        <input id="deliveryNote" name="deliveryNote" type="text" maxlength="200" value="{{ form.deliveryNote }}" placeholder="z. B. Fertigung nach Bezahlung">
        <span class="hint">Ergänzt die Lieferzeit, z. B. „Fertigung nach Bezahlung“ oder „sofort lieferbar“. Leer lassen, um keinen Hinweis anzuzeigen.</span>
      </div>
    </div>

    <fieldset class="admin-fieldset">
      <legend>Kategorien</legend>
      {% if categoryOptions.length > 0 %}
        <div class="admin-check-list">
          {% for category in categoryOptions %}
            <label class="admin-check admin-check-inline">
              <input type="checkbox" name="productCategories" value="{{ category.id }}" {% if category.id in categoryIds %}checked{% endif %}>
              <span>{{ category.name }}</span>
            </label>
          {% endfor %}
        </div>
        <span class="hint">Mehrfachauswahl möglich. Kategorien unter <a href="/admin/kategorien/">Kategorien</a> verwalten.</span>
      {% else %}
        <p class="text-muted">Noch keine Kategorien vorhanden. <a href="/admin/kategorien/">Kategorie anlegen</a>.</p>
      {% endif %}
    </fieldset>

    <div class="form-row form-row-3">
      <div class="field">
        <label for="priceFrom">Preis von (€)</label>
        <input id="priceFrom" name="priceFrom" type="number" min="0" step="0.01" required value="{{ form.priceFrom }}">
      </div>
      <div class="field">
        <label for="priceTo">Preis bis (€)</label>
        <input id="priceTo" name="priceTo" type="number" min="0" step="0.01" value="{{ form.priceTo }}">
        <span class="hint">Leer lassen, wenn es nur einen Preis gibt.</span>
      </div>
      <div class="field">
        <label for="sku">Artikelnummer (SKU)</label>
        <input id="sku" name="sku" type="text" maxlength="60" value="{{ form.sku }}">
      </div>
    </div>

    <div class="form-row form-row-3">
      <div class="field">
        <label for="weightG">Gewicht (g)</label>
        <input id="weightG" name="weightG" type="number" min="0" step="0.1" value="{{ form.weightG }}">
      </div>
      <div class="field">
        <label for="dimensions">Maße</label>
        <input id="dimensions" name="dimensions" type="text" maxlength="100" value="{{ form.dimensions }}" placeholder="z. B. 110 × 65 × 87 mm">
      </div>
      <div class="field">
        <label for="stock">Lagerbestand</label>
        <input id="stock" name="stock" type="number" min="0" step="1" value="{{ form.stock }}">
        <span class="hint">Leer = keine Bestandsführung.</span>
      </div>
    </div>

    <div class="form-row">
      <div class="field">
        <label for="sortOrder">Sortierung</label>
        <input id="sortOrder" name="sortOrder" type="number" step="1" value="{{ form.sortOrder }}">
        <span class="hint">Bei einer bereits vergebenen Nummer rücken die folgenden Produkte auf. Alternativ können Sie die Produkte in der Liste mit Pfeilen oder per Drag & Drop sortieren.</span>
      </div>
      <label class="admin-check">
        <input type="checkbox" name="active" value="1" {% if form.active %}checked{% endif %}>
        <span>Produkt im Shop anzeigen</span>
      </label>
    </div>

    <fieldset class="admin-fieldset">
      <legend>Versandarten für dieses Produkt</legend>
      <p class="hint">Nur ausgewählte Versandarten werden im Checkout angeboten. Keine Auswahl = alle aktiven Versandarten.</p>
      <div class="admin-check-list">
        {% for method in shippingMethods %}
          <label class="admin-check admin-check-inline">
            <input type="checkbox" name="shippingMethodIds" value="{{ method.id }}" {% if method.id in form.shippingMethodIds %}checked{% endif %}>
            <span>{{ method.label }}{% if method.active == false %} (inaktiv){% endif %}</span>
          </label>
        {% else %}
          <p class="text-muted">Keine Versandarten vorhanden. Bitte unter „Preise → Versand“ anlegen.</p>
        {% endfor %}
      </div>
    </fieldset>

    <fieldset class="admin-fieldset">
      <legend>Versand-Zusatzoptionen</legend>
      <p class="hint">Optionen wie Expressversand oder Geschenkverpackung, die für dieses Produkt im Checkout wählbar sind. Preise werden unter „Preise → Versandoptionen“ gepflegt.</p>
      <div class="admin-check-list">
        {% for option in shippingOptions %}
          <label class="admin-check admin-check-inline">
            <input type="checkbox" name="shippingOptionIds" value="{{ option.id }}" {% if option.id in form.shippingOptionIds %}checked{% endif %}>
            <span>{{ option.label }}{% if option.price > 0 %} (+ {{ option.price | euro }}){% endif %}{% if option.active == false %} (inaktiv){% endif %}</span>
          </label>
        {% else %}
          <p class="text-muted">Keine Versandoptionen vorhanden. Bitte unter „Preise → Versandoptionen“ anlegen.</p>
        {% endfor %}
      </div>
    </fieldset>

    <fieldset class="admin-fieldset">
      <legend>Varianten, Farben und Personalisierung</legend>
      <div class="field">
        <label for="colorOptions">Farbvarianten (kommagetrennt)</label>
        <input id="colorOptions" name="colorOptions" type="text" maxlength="1000" value="{{ form.colorOptions }}" placeholder="z. B. Schwarz, Weiß, Rot, Blau">
        <span class="hint">Zusätzliche Farbauswahl ohne Preisunterschied. Leer lassen, wenn das Produkt keine Farbauswahl hat. Farben lassen sich mit Varianten kombinieren.</span>
      </div>
      <label class="admin-check">
        <input type="checkbox" name="personalizationEnabled" value="1" {% if form.personalizationEnabled %}checked{% endif %}>
        <span>Personalisierung anbieten</span>
      </label>
      <span class="hint">Zeigt im Shop ein optionales Textfeld für eine persönliche Anmerkung. Der Kunde muss es nicht ausfüllen.</span>
      <div class="field">
        <label for="personalizationHint">Hinweis im Personalisierungsfeld</label>
        <input id="personalizationHint" name="personalizationHint" type="text" maxlength="200" value="{{ form.personalizationHint }}" placeholder="z. B. Name oder kurzer Text">
        <span class="hint">Wird im Shop als grauer Platzhaltertext im Feld angezeigt, z. B. „z. B. Name oder kurzer Text“. Leer lassen für den Standardtext.</span>
      </div>
      <div class="field">
        <label for="personalizationPrice">Aufpreis bei Personalisierung (€ pro Stück)</label>
        <input id="personalizationPrice" name="personalizationPrice" type="number" min="0" max="1000000" step="0.01" value="{{ form.personalizationPrice }}" inputmode="decimal">
        <span class="hint">Wird nur berechnet, wenn der Kunde tatsächlich einen Text eingibt. Dann gilt der Aufpreis für jedes Stück der Position. Leer lassen oder 0,00 € für keinen Aufpreis.</span>
      </div>
    </fieldset>

    <div class="form-actions">
      <button class="btn" type="submit">Speichern</button>
      <a class="btn btn-secondary" href="/admin/produkte/">Zurück</a>
    </div>
  </form>

  {% if not isNew %}
    <section class="card admin-panel">
      <h2>Varianten</h2>
      <p class="text-muted">Varianten sind echte Ausführungen wie Größe oder Modell mit eigenem Preis und Bestand. Produkte ohne Varianten sind direkt kaufbar. Farben werden oben als kommagetrennte Liste gepflegt.</p>
      <form method="post" action="/admin/produkte/{{ product.id }}/varianten/">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <div class="table-wrap">
          <table>
            <thead><tr><th>Bezeichnung</th><th>Preis (€)</th><th>Bestand</th><th>Löschen</th></tr></thead>
            <tbody>
              {% for variant in variants %}
                <tr>
                  <td><input name="variant_{{ variant.id }}_label" type="text" maxlength="80" required value="{{ variant.label }}"></td>
                  <td><input name="variant_{{ variant.id }}_price" type="number" min="0" step="0.01" required value="{{ variant.priceValue }}"></td>
                  <td><input name="variant_{{ variant.id }}_stock" type="number" min="0" step="1" value="{{ variant.stockValue }}"></td>
                  <td><label class="admin-check admin-check-inline"><input type="checkbox" name="variant_{{ variant.id }}_delete" value="1"><span>löschen</span></label></td>
                </tr>
              {% endfor %}
              <tr>
                <td><input name="new_label" type="text" maxlength="80" placeholder="Neue Variante"></td>
                <td><input name="new_price" type="number" min="0" step="0.01" placeholder="0.00"></td>
                <td><input name="new_stock" type="number" min="0" step="1" placeholder="optional"></td>
                <td></td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="form-actions">
          <button class="btn" type="submit">Varianten speichern</button>
        </div>
      </form>
    </section>

    <section class="card admin-panel">
      <h2>Bilder</h2>
      <p class="text-muted">JPG, PNG, WebP oder AVIF, maximal 12 MB und 12 Bilder pro Produkt. Beim Hochladen werden automatisch AVIF-, WebP- und JPG-Varianten erzeugt und Metadaten entfernt.</p>

      {% if images.length > 0 %}
        <p class="hint">Reihenfolge: Karten ziehen oder die Pfeile nutzen. Mit dem Stift lässt sich jedes Bild zuschneiden. Die Nummern werden fortlaufend vergeben.</p>
        <div class="admin-image-grid" data-image-order-list data-product-id="{{ product.id }}" data-csrf="{{ csrf }}">
          {% for image in images %}
            <div class="admin-image-card" data-image-id="{{ image.id }}" data-crop-url="{{ image.cropUrl }}" data-crop-label="{{ image.alt or product.name }}" {% if images.length > 1 %}draggable="true"{% endif %}>
              <div class="admin-image-card-head">
                <span class="admin-sort-grip" aria-hidden="true">{{ icon('grip') }}</span>
                <span class="admin-sort-number">{{ loop.index }}</span>
                <span class="admin-sort-controls">
                  <form method="post" action="/admin/produkte/{{ product.id }}/bilder/{{ image.id }}/sortierung/">
                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                    <input type="hidden" name="richtung" value="hoch">
                    <button class="admin-icon-btn" type="submit" data-tooltip="Nach oben" aria-label="Bild {{ loop.index }} nach oben verschieben" {% if loop.first %}disabled{% endif %}>{{ icon('arrow-up') }}</button>
                  </form>
                  <form method="post" action="/admin/produkte/{{ product.id }}/bilder/{{ image.id }}/sortierung/">
                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                    <input type="hidden" name="richtung" value="runter">
                    <button class="admin-icon-btn" type="submit" data-tooltip="Nach unten" aria-label="Bild {{ loop.index }} nach unten verschieben" {% if loop.last %}disabled{% endif %}>{{ icon('arrow-down') }}</button>
                  </form>
                </span>
              </div>
              {% if image.canCrop %}
                <button type="button" class="admin-image-edit" data-product-image-crop aria-label="Bild zuschneiden: {{ image.alt or product.name }}" title="Bild zuschneiden">
                  <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M4 16h3l8.5-8.5a1.8 1.8 0 0 0-2.5-2.5L4.5 13.5V16Z"/></svg>
                </button>
              {% endif %}
              {% if image.previewUrl %}
                <img src="{{ image.previewUrl }}" alt="{{ image.alt }}" width="240" height="160" loading="lazy" decoding="async" draggable="false">
              {% else %}
                <p class="text-muted"><small>Vorschau nicht verfügbar</small></p>
              {% endif %}
              <form class="admin-image-settings" method="post" action="/admin/produkte/{{ product.id }}/bilder/{{ image.id }}/">
                <input type="hidden" name="_csrf" value="{{ csrf }}">
                <div class="field">
                  <label for="image_{{ image.id }}_alt">Alternativtext</label>
                  <input id="image_{{ image.id }}_alt" name="alt" type="text" maxlength="200" value="{{ image.alt }}">
                </div>
                <div class="admin-image-actions">
                  <label class="admin-check admin-check-inline">
                    <input type="checkbox" name="delete" value="1">
                    <span>löschen</span>
                  </label>
                  <button class="btn btn-small" type="submit">Speichern</button>
                </div>
              </form>
              <small class="text-muted"><code class="admin-code">{{ image.file }}</code></small>
            </div>
          {% endfor %}
        </div>

        <dialog class="admin-modal" data-product-crop-modal>
          <form class="admin-modal-form" method="post" data-product-crop-form>
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <input type="hidden" name="x" value="0" data-crop-x>
            <input type="hidden" name="y" value="0" data-crop-y>
            <input type="hidden" name="width" value="1" data-crop-width>
            <input type="hidden" name="height" value="1" data-crop-height>
            <div class="admin-modal-head">
              <h2>Bild zuschneiden</h2>
              <button type="button" class="admin-modal-close" data-modal-close aria-label="Schließen">&times;</button>
            </div>
            <p class="text-muted" data-product-crop-name></p>
            <div class="admin-crop">
              <div class="admin-crop-stage" data-product-crop-stage>
                <img data-product-crop-image alt="Vorschau mit Zuschnitt">
                <div class="admin-crop-box" data-product-crop-box>
                  <span class="admin-crop-handle" data-crop-handle="nw"></span>
                  <span class="admin-crop-handle" data-crop-handle="ne"></span>
                  <span class="admin-crop-handle" data-crop-handle="sw"></span>
                  <span class="admin-crop-handle" data-crop-handle="se"></span>
                </div>
              </div>
              <div class="admin-crop-actions">
                <button type="button" class="btn btn-secondary btn-small" data-product-crop-reset>Ausschnitt zurücksetzen</button>
                <span class="hint">Ziehen zum Verschieben, an den Ecken ziehen zum Verkleinern.</span>
              </div>
            </div>
            <div class="admin-modal-actions">
              <button type="button" class="btn btn-secondary" data-modal-close>Abbrechen</button>
              <button type="submit" class="btn">Zuschnitt speichern</button>
            </div>
          </form>
        </dialog>
      {% else %}
        <p class="text-muted">Für dieses Produkt ist noch kein Bild hinterlegt.</p>
      {% endif %}

      <div class="admin-upload">
        <h3>Bild hinzufügen</h3>
        <form method="post" action="/admin/produkte/{{ product.id }}/bilder/" enctype="multipart/form-data" data-upload-form>
          <input type="hidden" name="_csrf" value="{{ csrf }}">
          <div class="form-row">
            <div class="field">
              <label for="image_file">Bilddateien</label>
              <input id="image_file" name="image" type="file" accept="image/jpeg,image/png,image/webp,image/avif" multiple required>
              <span class="hint">Mehrere Dateien gleichzeitig auswählen (Strg/Cmd gedrückt halten). Automatische Drehung, Verkleinerung und Umwandlung in AVIF, WebP und JPG.</span>
            </div>
            <div class="field">
              <label for="image_alt">Alternativtext</label>
              <input id="image_alt" name="alt" type="text" maxlength="200" placeholder="Beschreibung für Screenreader und Suchmaschinen">
              <span class="hint">Gilt für alle Bilder dieses Uploads und kann danach einzeln geändert werden.</span>
            </div>
          </div>
          <div class="form-actions">
            <button class="btn" type="submit">Bilder hochladen</button>
          </div>
          <div class="upload-progress" data-upload-progress hidden>
            <progress max="100" value="0" data-upload-bar aria-label="Upload-Fortschritt"></progress>
            <p class="upload-status" data-upload-status role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </section>
  {% endif %}
{% endblock %}
