{% extends "layouts/admin.njk" %}

{% block title %}Bestellung {{ order.order_number }} – 3D-MIR Admin{% endblock %}

{% block content %}
  <nav class="breadcrumb" aria-label="Brotkrumen">
    <ol><li><a href="/admin/bestellungen/">Bestellungen</a></li><li aria-current="page">{{ order.order_number }}</li></ol>
  </nav>

  <div class="admin-page-head">
    <div>
      <h1>Bestellung {{ order.order_number }}</h1>
      <p>Eingegangen am {{ order.created_at | date }} · zuletzt geändert am {{ order.updated_at | date }}</p>
    </div>
    <div class="admin-page-actions">
      {% if order.status == 'neu' %}<span class="badge badge-warning">Neu</span>
      {% elif order.status == 'bezahlt' %}<span class="badge badge-info">Bezahlt</span>
      {% elif order.status == 'in_druck' %}<span class="badge badge-info">In Druck</span>
      {% elif order.status == 'versandt' %}<span class="badge badge-success">Versandt</span>
      {% elif order.status == 'abgeschlossen' %}<span class="badge badge-success">Abgeschlossen</span>
      {% else %}<span class="badge badge-danger">Storniert</span>{% endif %}
      <span class="badge badge-{{ paymentStatusTone }}">{{ paymentStatusText }}</span>
    </div>
  </div>

  <div class="admin-grid-2 admin-grid-wide">
    <section class="card admin-panel">
      <h2>Kunde und Lieferadresse</h2>
      <dl class="admin-dl">
        <div><dt>Name</dt><dd>{{ order.first_name }} {{ order.last_name }}</dd></div>
        {% if order.company %}<div><dt>Firma</dt><dd>{{ order.company }}</dd></div>{% endif %}
        <div><dt>E-Mail</dt><dd><a href="mailto:{{ order.email }}">{{ order.email }}</a></dd></div>
        <div><dt>Telefon</dt><dd>{{ order.phone or '–' }}</dd></div>
        <div><dt>Adresse</dt><dd>{{ order.street }}{% if order.address_extra %}, {{ order.address_extra }}{% endif %}<br>{{ order.zip }} {{ order.city }}<br>{{ order.country }}</dd></div>
      </dl>

      <h2 class="mt-2">Positionen</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Artikel</th><th>Menge</th><th class="text-right">Einzelpreis</th><th class="text-right">Summe</th></tr></thead>
          <tbody>
            {% for item in items %}
              <tr>
                <td>{{ item.name }}{% if item.variant %}<br><small class="text-muted">{{ item.variant }}</small>{% endif %}{% if item.color %}<br><small class="text-muted">Farbe: {{ item.color }}</small>{% endif %}{% if item.personalization %}<br><small class="text-muted">Personalisierung: {{ item.personalization }}</small>{% endif %}</td>
                <td>{{ item.quantity }}</td>
                <td class="text-right">{{ item.unit_price_cents | price }}</td>
                <td class="text-right">{{ item.line_total_cents | price }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <dl class="admin-dl admin-totals">
        <div><dt>Zwischensumme</dt><dd>{{ order.subtotal_cents | price }}</dd></div>
        <div><dt>Versand ({{ shippingLabel }})</dt><dd>{{ order.shipping_cents | price }}</dd></div>
        {% for option in options %}
          <div><dt>Option: {{ option.label }}</dt><dd>{{ option.price_cents | price }}</dd></div>
        {% endfor %}
        <div class="admin-total"><dt>Gesamt</dt><dd>{{ order.total_cents | price }}</dd></div>
      </dl>

      <dl class="admin-dl">
        <div><dt>Zahlungsart</dt><dd>{{ paymentLabel }}</dd></div>
        <div><dt>Zahlungsstatus</dt><dd><span class="badge badge-{{ paymentStatusTone }}">{{ paymentStatusText }}</span></dd></div>
        <div><dt>Zahlungsanbieter</dt><dd>{{ paymentProviderText }}</dd></div>
        {% if order.payment_reference %}<div><dt>Referenz</dt><dd><code>{{ order.payment_reference }}</code></dd></div>{% endif %}
        {% if order.paid_at %}<div><dt>Zahlung eingegangen</dt><dd>{{ order.paid_at | date }}</dd></div>{% endif %}
        {% if order.payment_note %}<div><dt>Zahlungshinweis</dt><dd>{{ order.payment_note }}</dd></div>{% endif %}
        <div><dt>Versandart</dt><dd>{{ shippingLabel }}</dd></div>
        <div><dt>Kundenanmerkung</dt><dd>{{ order.customer_note or '–' }}</dd></div>
      </dl>
    </section>

    <section class="card admin-panel">
      <h2>Bearbeiten</h2>
      <form class="form" method="post" action="/admin/bestellungen/{{ order.id }}/">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <div class="field">
          <label for="status">Status</label>
          <select id="status" name="status">
            {% for item in statuses %}
              <option value="{{ item.id }}" {% if order.status == item.id %}selected{% endif %}>{{ item.label }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="field">
          <label for="adminNote">Interne Notiz</label>
          <textarea id="adminNote" name="adminNote" rows="5" maxlength="2000">{{ order.admin_note }}</textarea>
          <span class="hint">Nur im Admin-Bereich sichtbar.</span>
        </div>
        <label class="admin-check">
          <input type="checkbox" name="notify" value="1">
          <span>Kunden bei Statusänderung per E-Mail informieren</span>
        </label>
        <div class="form-actions">
          <button class="btn" type="submit">Speichern</button>
          <a class="btn btn-secondary" href="/admin/bestellungen/">Zurück</a>
        </div>
      </form>

      <h2 class="mt-2">Zahlung</h2>
      {% if order.payment_status == 'bezahlt' %}
        <p><span class="badge badge-success">Zahlung eingegangen</span>{% if order.paid_at %} am {{ order.paid_at | date }}{% endif %}</p>
        <form method="post" action="/admin/bestellungen/{{ order.id }}/zahlung/">
          <input type="hidden" name="_csrf" value="{{ csrf }}">
          <input type="hidden" name="action" value="refunded">
          <button class="btn btn-secondary btn-small" type="submit">Erstattung vermerken</button>
        </form>
        <p class="hint">Die eigentliche Erstattung erfolgt im Stripe-Dashboard bzw. per Überweisung. Hier wird nur der Status vermerkt.</p>
      {% else %}
        <div class="admin-page-actions">
          <form method="post" action="/admin/bestellungen/{{ order.id }}/zahlung/">
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <input type="hidden" name="action" value="paid">
            <button class="btn btn-small" type="submit">Zahlungseingang bestätigen</button>
          </form>
          <form method="post" action="/admin/bestellungen/{{ order.id }}/zahlung/">
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <input type="hidden" name="action" value="failed">
            <button class="btn btn-secondary btn-small" type="submit">Als fehlgeschlagen markieren</button>
          </form>
        </div>
        <p class="hint">Bei Vorkasse bestätigt dies den Geldeingang. Bei Stripe wird der Status normalerweise automatisch gesetzt.</p>
      {% endif %}

      <h2 class="mt-2">Statusverlauf</h2>
      {% if history.length > 0 %}
        <ul class="admin-history">
          {% for entry in history %}
            <li>
              <strong>{{ entry.from_status or '–' }} → {{ entry.to_status }}</strong>
              <small class="text-muted">{{ entry.created_at | date }} · {{ entry.actor }}</small>
              {% if entry.note %}<span>{{ entry.note }}</span>{% endif %}
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="text-muted">Noch keine Statusänderung protokolliert.</p>
      {% endif %}
    </section>
  </div>
{% endblock %}
