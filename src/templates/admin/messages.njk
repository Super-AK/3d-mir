{% extends "layouts/admin.njk" %}

{% block title %}Nachrichten – 3D-MIR Admin{% endblock %}

{% block content %}
  <div class="admin-page-head">
    <div>
      <h1>Nachrichten</h1>
      <p>Anfragen aus dem Kontaktformular. Nachrichten mit auffälligem Land oder Inhalt warten auf eine manuelle Prüfung.</p>
    </div>
    {% if reviewCount > 0 or spamCount > 0 or blockedCount > 0 %}
      <div class="admin-page-actions">
        {% if reviewCount > 0 %}<span class="badge badge-warning">{{ reviewCount }} zur Prüfung</span>{% endif %}
        {% if spamCount > 0 %}<span class="badge badge-neutral">{{ spamCount }} als Spam</span>{% endif %}
        {% if blockedCount > 0 %}<span class="badge badge-danger">{{ blockedCount }} gesperrt</span>{% endif %}
      </div>
    {% endif %}
  </div>

  {% if meldung.antwort == 'gesendet' %}
    <div class="alert alert-success" role="status"><p>Die Antwort wurde per E-Mail versendet.</p></div>
  {% elif meldung.antwort == 'datei' %}
    <div class="alert alert-warning" role="status"><p>SMTP ist nicht eingerichtet. Die Antwort wurde als <code>.eml</code>-Datei unter <code>/var/log/3d-mir/mail/</code> gespeichert.</p></div>
  {% endif %}

  <details class="admin-help admin-contact-settings">
    <summary class="btn btn-secondary btn-small">Spam-Schutz und Länderprüfung</summary>
    <div class="admin-help-body">
      {% if geoip.available and not geoip.error %}
        <div class="alert alert-info" role="status">
          <p><strong>Ländererkennung aktiv:</strong> Das Land wird anhand der IP-Adresse aus der lokalen Datenbank <code>{{ geoip.path }}</code> ermittelt. Es werden keine externen Dienste aufgerufen.</p>
        </div>
      {% elif geoip.available %}
        <div class="alert alert-warning" role="status">
          <p><strong>GeoIP-Datenbank nicht lesbar:</strong> <code>{{ geoip.path }}</code> – {{ geoip.error }}. Bitte <code>sudo deploy/update-geoip.sh</code> ausführen. Bis dahin greift die Einstellung „Land nicht ermittelbar“.</p>
        </div>
      {% else %}
        <div class="alert alert-warning" role="status">
          <p><strong>Keine GeoIP-Datenbank gefunden.</strong> Ohne Datenbank kann das Land nur über einen vertrauenswürdigen Proxy-Header (z. B. <code>CF-IPCountry</code>) ermittelt werden. Andernfalls greift die Einstellung „Land nicht ermittelbar“. Installation: <code>sudo deploy/update-geoip.sh</code>.</p>
        </div>
      {% endif %}

      <form class="form" method="post" action="/admin/nachrichten/einstellungen/">
        <input type="hidden" name="_csrf" value="{{ csrf }}">

        <div class="form-row">
          <div class="field">
            <label for="contactMode">Verhalten bei Auffälligkeiten</label>
            <select id="contactMode" name="mode">
              <option value="review" {% if contactSettings.mode != 'block' %}selected{% endif %}>Zur Prüfung speichern (empfohlen)</option>
              <option value="block" {% if contactSettings.mode == 'block' %}selected{% endif %}>Anfrage direkt ablehnen</option>
            </select>
            <span class="hint">Gilt für bekannte, aber nicht erlaubte Länder sowie für die Zeit- und Inhaltsprüfung. Im Prüfmodus wird die Nachricht gespeichert, aber nicht an den Betreiber weitergeleitet.</span>
          </div>
          <div class="field">
            <label for="unknownCountry">Land nicht ermittelbar</label>
            <select id="unknownCountry" name="unknownCountry">
              <option value="review" {% if contactSettings.unknownCountry != 'block' and contactSettings.unknownCountry != 'allow' %}selected{% endif %}>Zur Prüfung speichern (empfohlen)</option>
              <option value="block" {% if contactSettings.unknownCountry == 'block' %}selected{% endif %}>Anfrage direkt ablehnen</option>
              <option value="allow" {% if contactSettings.unknownCountry == 'allow' %}selected{% endif %}>Ohne Länderprüfung zulassen</option>
            </select>
            <span class="hint">Gilt, wenn weder Datenbank noch Proxy-Header ein Land liefern.</span>
          </div>
        </div>

        <label class="checkbox">
          <input type="checkbox" name="countryCheck" value="1" {% if contactSettings.countryCheck %}checked{% endif %}>
          <span>Länderprüfung aktiv: Nur Anfragen aus den ausgewählten Ländern zulassen.</span>
        </label>

        <div class="field">
          <span class="field-label">Erlaubte Länder</span>
          <div class="admin-check-list admin-country-list">
            {% for country in countries %}
              <label class="admin-check admin-check-inline">
                <input type="checkbox" name="allowedCountries" value="{{ country.code }}" {% if country.code in contactSettings.allowedCountries %}checked{% endif %}>
                <span>{{ country.name }} <code class="admin-code">{{ country.code }}</code></span>
              </label>
            {% endfor %}
          </div>
          <span class="hint">Mehrfachauswahl möglich. Das Land wird ausschließlich serverseitig aus der IP-Adresse ermittelt; der Besucher gibt es nicht selbst an. Standard ist Deutschland.</span>
        </div>

        <label class="checkbox">
          <input type="checkbox" name="timeCheck" value="1" {% if contactSettings.timeCheck %}checked{% endif %}>
          <span>Zeitprüfung: Formular muss mindestens 3 Sekunden geöffnet gewesen sein.</span>
        </label>
        <label class="checkbox">
          <input type="checkbox" name="contentCheck" value="1" {% if contactSettings.contentCheck %}checked{% endif %}>
          <span>Inhaltsprüfung: Viele Links, typische Spam-Begriffe oder überwiegende Großschreibung erkennen.</span>
        </label>

        <fieldset class="admin-fieldset">
          <legend>Automatische Absender-Sperre</legend>
          <label class="checkbox">
            <input type="checkbox" name="spamBanEnabled" value="1" {% if contactSettings.spamBanEnabled %}checked{% endif %}>
            <span>Absender nach wiederholten auffälligen Versuchen automatisch sperren.</span>
          </label>
          <div class="form-row">
            <div class="field">
              <label for="spamBanThreshold">Versuche bis zur Sperre</label>
              <select id="spamBanThreshold" name="spamBanThreshold">
                <option value="3" {% if contactSettings.spamBanThreshold == 3 %}selected{% endif %}>3 Versuche</option>
                <option value="5" {% if contactSettings.spamBanThreshold != 3 %}selected{% endif %}>5 Versuche</option>
              </select>
            </div>
            <div class="field">
              <label for="spamBanWindowMinutes">Zeitfenster (Minuten)</label>
              <input id="spamBanWindowMinutes" name="spamBanWindowMinutes" type="number" min="5" max="1440" step="1" value="{{ contactSettings.spamBanWindowMinutes }}">
              <span class="hint">Nur Versuche innerhalb dieses Zeitraums werden gezählt.</span>
            </div>
            <div class="field">
              <label for="spamBanHours">Sperrdauer (Stunden)</label>
              <input id="spamBanHours" name="spamBanHours" type="number" min="0" max="8760" step="1" value="{{ contactSettings.spamBanHours }}">
              <span class="hint">0 = dauerhaft, bis Sie die Sperre manuell aufheben.</span>
            </div>
          </div>
          <p class="hint">Gezählt werden nur auffällige Versuche: nicht freigegebenes Land, Zeitprüfung, Spam-Inhalt oder Honeypot. Gespeichert werden eine gekürzte IP-Adresse und eine Prüfsumme, nicht die vollständige IP-Adresse.</p>
        </fieldset>

        <div class="form-actions">
          <button class="btn" type="submit">Einstellungen speichern</button>
        </div>
      </form>
    </div>
  </details>

  {% if blocks.length > 0 %}
    <section class="card admin-panel">
      <h2>Gesperrte und auffällige Absender</h2>
      <p class="text-muted">Wiederholte Spam-Versuche werden hier zusammengeführt. Eine aktive Sperre verhindert weitere Benachrichtigungen; die Anfragen werden nicht mehr gespeichert.</p>
      <div class="admin-table-wrap">
        <table class="admin-table admin-edit-table">
          <thead>
            <tr>
              <th>Status</th>
              <th>IP-Bereich / Prüfsumme</th>
              <th>Land</th>
              <th>Versuche</th>
              <th>Zuletzt</th>
              <th>Browser</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {% for block in blocks %}
              <tr id="absender-{{ block.id }}">
                <td>
                  {% if block.active %}
                    <span class="badge badge-danger">gesperrt</span>
                  {% else %}
                    <span class="badge badge-neutral">beobachtet</span>
                  {% endif %}
                </td>
                <td>
                  <code class="admin-code">{{ block.ip_prefix or 'unbekannt' }}</code><br>
                  <small class="text-muted" title="Prüfsumme der IP-Adresse">{{ block.ip_hash | truncate(12, true, '…') }}</small>
                </td>
                <td>{{ countryLabels[block.country] or block.country or 'unbekannt' }}</td>
                <td>{{ block.attempts }}</td>
                <td>{{ block.last_seen | date }}</td>
                <td><span title="{{ block.user_agent }}">{{ block.user_agent | truncate(50) or '–' }}</span></td>
                <td class="admin-row-actions">
                  {% if block.active %}
                    <form method="post" action="/admin/nachrichten/sperren/{{ block.id }}/aufheben/">
                      <input type="hidden" name="_csrf" value="{{ csrf }}">
                      <button class="btn btn-secondary btn-small" type="submit">Sperre aufheben</button>
                    </form>
                  {% endif %}
                </td>
              </tr>
              {% if block.reason %}
                <tr class="admin-detail-row">
                  <td colspan="7"><small class="text-muted">Letzter Grund: {{ block.reason }}</small></td>
                </tr>
              {% endif %}
            {% endfor %}
          </tbody>
        </table>
      </div>
      <p class="hint">Die vollständige IP-Adresse wird nicht gespeichert. Beobachtete Absender ohne aktive Sperre werden nach 30 Tagen ohne Aktivität automatisch entfernt.</p>
    </section>
  {% endif %}

  <nav class="admin-filter-tabs" aria-label="Nachrichten filtern">
    <a class="{% if not status %}is-active{% endif %}" href="/admin/nachrichten/">Alle <span>{{ counts.total }}</span></a>
    <a class="{% if status == 'offen' %}is-active{% endif %}" href="/admin/nachrichten/?status=offen">Offen <span>{{ counts.open }}</span></a>
    <a class="{% if status == 'pruefung' %}is-active{% endif %}" href="/admin/nachrichten/?status=pruefung">Prüfung <span>{{ counts.review }}</span></a>
    <a class="{% if status == 'spam' %}is-active{% endif %}" href="/admin/nachrichten/?status=spam">Spam <span>{{ counts.spam }}</span></a>
    <a class="{% if status == 'erledigt' %}is-active{% endif %}" href="/admin/nachrichten/?status=erledigt">Erledigt <span>{{ counts.done }}</span></a>
  </nav>

  {% if messages.length > 0 %}
    <form id="messages-bulk" method="post" action="/admin/nachrichten/massenaktion/">
      <input type="hidden" name="_csrf" value="{{ csrf }}">
      <input type="hidden" name="status" value="{{ status }}">
    </form>

    <div class="admin-messages-toolbar">
      <p class="text-muted">{{ messages.length }} Nachricht(en) in dieser Ansicht.</p>
      <div class="admin-bulk-form">
        <label class="admin-check admin-check-inline">
          <input type="checkbox" data-select-all-messages aria-label="Alle Nachrichten auswählen">
          <span>Alle</span>
        </label>
        <select name="action" form="messages-bulk" aria-label="Massenaktion">
          <option value="handled">Als erledigt markieren</option>
          <option value="reopen">Wieder öffnen</option>
          <option value="approve">Freigeben / Kein Spam</option>
          <option value="spam">Als Spam markieren</option>
          <option value="delete">Endgültig löschen</option>
        </select>
        <button class="btn btn-secondary btn-small" type="submit" form="messages-bulk">Ausführen</button>
        <span class="text-muted" data-bulk-count>0 ausgewählt</span>
      </div>
    </div>

    <div class="admin-table-wrap">
      <table class="admin-table admin-message-table">
        <thead>
          <tr>
            <th class="admin-check-cell"><span class="visually-hidden">Auswählen</span></th>
            <th>Status</th>
            <th>Datum</th>
            <th>Absender</th>
            <th>Betreff</th>
            <th>Land</th>
            <th>Aktionen</th>
          </tr>
        </thead>
        <tbody>
          {% for message in messages %}
            <tr id="nachricht-{{ message.id }}" class="admin-message-row {% if message.handled %}is-handled{% endif %} {% if message.review_status == 'spam' %}is-spam{% endif %}" data-message-row data-href="/admin/nachrichten/{{ message.id }}/" tabindex="0">
              <td class="admin-check-cell">
                <input type="checkbox" name="ids" value="{{ message.id }}" form="messages-bulk" data-select-message aria-label="Nachricht von {{ message.name }} auswählen">
              </td>
              <td>
                {% if message.review_status == 'pruefen' %}<span class="badge badge-warning">Prüfung</span>{% endif %}
                {% if message.review_status == 'spam' %}<span class="badge badge-neutral">Spam</span>{% endif %}
                {% if message.handled %}<span class="badge badge-success">Erledigt</span>{% else %}<span class="badge badge-warning">Offen</span>{% endif %}
              </td>
              <td>{{ message.created_at | date }}</td>
              <td><strong>{{ message.name }}</strong><br><span class="text-muted">{{ message.email }}</span></td>
              <td><a href="/admin/nachrichten/{{ message.id }}/">{{ message.subject or 'Kontaktnachricht' }}</a></td>
              <td>{{ countryLabels[message.country] or message.country or '–' }}</td>
              <td>
                <div class="admin-row-actions">
                  <a class="btn btn-secondary btn-small" href="/admin/nachrichten/{{ message.id }}/">Öffnen</a>
                  <form method="post" action="/admin/nachrichten/{{ message.id }}/">
                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                    <input type="hidden" name="weiter" value="/admin/nachrichten/{% if status %}?status={{ status }}{% endif %}">
                    <input type="hidden" name="handled" value="{% if message.handled %}0{% else %}1{% endif %}">
                    <button class="btn btn-secondary btn-small" type="submit">{% if message.handled %}Wieder öffnen{% else %}Erledigt{% endif %}</button>
                  </form>
                  {% if message.review_status == 'pruefen' %}
                    <form method="post" action="/admin/nachrichten/{{ message.id }}/freigeben/">
                      <input type="hidden" name="_csrf" value="{{ csrf }}">
                      <input type="hidden" name="weiter" value="/admin/nachrichten/{% if status %}?status={{ status }}{% endif %}">
                      <button class="btn btn-small" type="submit">Freigeben</button>
                    </form>
                    <form method="post" action="/admin/nachrichten/{{ message.id }}/spam/">
                      <input type="hidden" name="_csrf" value="{{ csrf }}">
                      <input type="hidden" name="weiter" value="/admin/nachrichten/{% if status %}?status={{ status }}{% endif %}">
                      <button class="btn btn-secondary btn-small" type="submit">Spam</button>
                    </form>
                  {% elif message.review_status == 'spam' %}
                    <form method="post" action="/admin/nachrichten/{{ message.id }}/freigeben/">
                      <input type="hidden" name="_csrf" value="{{ csrf }}">
                      <input type="hidden" name="weiter" value="/admin/nachrichten/{% if status %}?status={{ status }}{% endif %}">
                      <button class="btn btn-small" type="submit">Freigeben</button>
                    </form>
                  {% endif %}
                  <a class="btn btn-danger btn-small" href="/admin/nachrichten/{{ message.id }}/loeschen/?weiter=/admin/nachrichten/">Löschen</a>
                </div>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <div class="card empty-state">
      <h2>Keine Nachrichten</h2>
      <p class="text-muted">{% if status %}Für diesen Filter sind keine Nachrichten vorhanden.{% else %}Über das Kontaktformular sind noch keine Nachrichten eingegangen.{% endif %}</p>
    </div>
  {% endif %}
{% endblock %}
