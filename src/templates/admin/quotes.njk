{% extends "layouts/admin.njk" %}

{% block title %}Anfragen – 3D-MIR Admin{% endblock %}

{% block content %}
  <div class="admin-page-head">
    <div>
      <h1>Anfragen</h1>
      <p>Angebotsanfragen aus dem 3D-Druck-Rechner prüfen und bearbeiten.</p>
    </div>
  </div>

  <form class="admin-filter card" method="get" action="/admin/anfragen/">
    <div class="field">
      <label for="status">Status</label>
      <select id="status" name="status">
        <option value="">Alle Status</option>
        {% for item in statuses %}
          <option value="{{ item.id }}" {% if status == item.id %}selected{% endif %}>{{ item.label }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="field">
      <label for="q">Suche</label>
      <input id="q" name="q" type="search" value="{{ q }}" placeholder="Referenz, E-Mail oder Name">
    </div>
    <div class="admin-filter-actions">
      <button class="btn btn-small" type="submit">Filtern</button>
      <a class="btn btn-secondary btn-small" href="/admin/anfragen/">Zurücksetzen</a>
    </div>
  </form>

  {% if quotes.length > 0 %}
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Referenz</th>
            <th>Datum</th>
            <th>Kunde</th>
            <th>Status</th>
            <th>Modell</th>
            <th class="text-right">Schätzung</th>
          </tr>
        </thead>
        <tbody>
          {% for quote in quotes %}
            <tr>
              <td><a href="/admin/anfragen/{{ quote.id }}/"><strong>{{ quote.reference }}</strong></a></td>
              <td>{{ quote.created_at | date }}</td>
              <td>{{ quote.name }}{% if quote.company %}<br><small class="text-muted">{{ quote.company }}</small>{% endif %}<br><small class="text-muted">{{ quote.email }}</small></td>
              <td>
                {% if quote.status == 'neu' %}<span class="badge badge-warning">Neu</span>
                {% elif quote.status == 'geprueft' %}<span class="badge badge-info">Geprüft</span>
                {% elif quote.status == 'angebot_gesendet' %}<span class="badge badge-info">Angebot gesendet</span>
                {% elif quote.status == 'angenommen' %}<span class="badge badge-success">Angenommen</span>
                {% elif quote.status == 'abgelehnt' %}<span class="badge badge-danger">Abgelehnt</span>
                {% else %}<span class="badge badge-neutral">Abgeschlossen</span>{% endif %}
              </td>
              <td><small>{{ quote.volume_cm3 | number(1) }} cm³ · {{ quote.weight_g | number(1) }} g<br>{{ quote.quantity }} Stück</small></td>
              <td class="text-right">{{ quote.estimated_price_cents | price }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <div class="card empty-state">
      <h2>Keine Anfragen gefunden</h2>
      <p class="text-muted">Für die gewählten Filter gibt es keine Einträge.</p>
    </div>
  {% endif %}
{% endblock %}
