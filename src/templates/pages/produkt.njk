{% extends "layouts/base.njk" %}

{% block title %}{{ product.name }} – 3D-MIR Shop{% endblock %}
{% block description %}{{ product.short_description }}{% endblock %}
{% block ogtitle %}{{ product.name }} – 3D-MIR{% endblock %}
{% block ogdescription %}{{ product.short_description }}{% endblock %}

{% block head %}
<script type="application/ld+json">{{ productJsonLd | jsonld | safe }}</script>
{% endblock %}

{% block content %}
<section class="page-head">
  <div class="container">
    <nav class="breadcrumb" aria-label="Brotkrumen">
      <ol>
        <li><a href="/">Start</a></li>
        <li><a href="/shop/">Shop</a></li>
        <li aria-current="page">{{ product.name }}</li>
      </ol>
    </nav>
  </div>
</section>

<section class="section product-section">
  <div class="container">
    {% if publication.shopStatus == 'PLATZHALTER' %}
      <div class="alert alert-warning" role="status">
        <p><strong>Hinweis:</strong> {{ shopConfig.notice }}</p>
      </div>
    {% endif %}

    <div class="product-layout">
      <div class="product-media">
        {% if images.length > 0 %}
          <div class="product-gallery" data-gallery>
            <div class="product-gallery-main">
              {% for item in images %}
                <figure class="gallery-slide{% if loop.first %} is-active{% endif %}" data-gallery-slide>
                  <a class="gallery-open" href="{{ imagePreview(item.file, 1200) }}" data-gallery-open aria-label="Bild vergrößern: {{ item.alt or product.name }}">
                    {{ image(item.file, { sizes: '(max-width: 620px) 100vw, 420px', alt: item.alt or product.name, priority: loop.first }) | safe }}
                    <span class="gallery-zoom" aria-hidden="true">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4M11 8v6M8 11h6"/></svg>
                      Vergrößern
                    </span>
                  </a>
                </figure>
              {% endfor %}
            </div>
            {% if images.length > 1 %}
              <nav class="gallery-thumbs" aria-label="Produktbilder auswählen">
                {% for item in images %}
                  <a class="gallery-thumb{% if loop.first %} is-active{% endif %}" href="{{ imagePreview(item.file, 1200) }}" data-gallery-thumb="{{ loop.index0 }}" aria-label="Bild {{ loop.index }} anzeigen"{% if loop.first %} aria-current="true"{% endif %}>
                    {{ imageThumbnail(item.file) | safe }}
                  </a>
                {% endfor %}
              </nav>
            {% endif %}
          </div>
          <dialog class="gallery-dialog" data-gallery-dialog aria-label="Bildvergrößerung">
            <div class="gallery-dialog-bar">
              <span class="gallery-dialog-counter" data-gallery-counter>1 / {{ images.length }}</span>
              <button class="gallery-dialog-close" type="button" data-gallery-close aria-label="Schließen">×</button>
            </div>
            <div class="gallery-dialog-body">
              {% if images.length > 1 %}
                <button class="gallery-dialog-nav gallery-dialog-prev" type="button" data-gallery-prev aria-label="Vorheriges Bild">‹</button>
              {% endif %}
              <img data-gallery-dialog-image alt="">
              {% if images.length > 1 %}
                <button class="gallery-dialog-nav gallery-dialog-next" type="button" data-gallery-next aria-label="Nächstes Bild">›</button>
              {% endif %}
            </div>
          </dialog>
        {% else %}
          {{ image('product-battery-box', { sizes: '(max-width: 860px) 100vw, 52vw', alt: product.name, priority: true }) | safe }}
        {% endif %}
      </div>

      <div class="product-info">
        <p class="eyebrow">{% if categories.length > 0 %}{{ categories[0].name }}{% else %}3D-Druck{% endif %} · 3D-Druck</p>
        <h1>{{ product.name }}</h1>
        {% if product.sku %}<p class="product-sku">Artikelnummer: {{ product.sku }}</p>{% endif %}

        <p class="product-price product-price-large" data-product-price data-price-base="{{ basePriceText }}">{{ basePriceText }}</p>
        <p class="text-muted"><small>{{ site.business.vatNote }} zzgl. Versandkosten.</small></p>

        <p>{{ product.short_description }}</p>

        <form class="product-form" method="post" action="/warenkorb/hinzufuegen/">
          <div class="field">
            <label for="variantId">Farbe</label>
            <select id="variantId" name="variantId" required data-variant-select>
              <option value="" selected disabled>Bitte Farbe wählen</option>
              {% for variant in variants %}
                <option value="{{ variant.id }}" data-price-cents="{{ variant.price_cents }}">{{ variant.label }} – {{ variant.price_cents | price }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="product-buy-row">
            <div class="field field-quantity">
              <label for="quantity">Menge</label>
              <input id="quantity" name="quantity" type="number" min="1" max="{{ maxQuantity }}" value="1" inputmode="numeric" required>
            </div>
            <button class="btn btn-block" type="submit" {% if variants.length == 0 %}disabled{% endif %}>In den Warenkorb</button>
          </div>
        </form>

        <ul class="product-facts">
          <li><strong>Lieferzeit:</strong> 2–5 Werktage, Fertigung nach Bestellung</li>
          <li><strong>Versand:</strong> {% if shippingFromPrice is not null %}ab {{ shippingFromPrice | euro }}{% else %}kostenlos{% endif %}{% if pricing.shipping.freeShippingFrom > 0 %}, frei ab {{ pricing.shipping.freeShippingFrom | euro }}{% endif %}</li>
          <li><strong>Abholung:</strong> nach Absprache in Schömberg möglich</li>
          <li><strong>Material:</strong> PLA, in Wunschfarbe</li>
        </ul>

        <div class="alert alert-info">
          <p><strong>Preishinweis:</strong> Die Farbzuordnung der Preise ist noch nicht bestätigt. Im Warenkorb wird der niedrigste Preis angesetzt; der verbindliche Preis wird vor der Fertigung geprüft. <a href="/kontakt/">Fragen?</a></p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-soft">
  <div class="container product-details">
    <div>
      <h2>Beschreibung</h2>
      {{ product.description | paragraphs | safe }}
    </div>
    <aside class="product-specs card">
      <h2>Auf einen Blick</h2>
      <dl>
        {% if categories.length > 0 %}
          <div><dt>Kategorie</dt><dd>{% for category in categories %}<a href="/shop/?kategorie={{ category.slug }}">{{ category.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</dd></div>
        {% endif %}
        {% if product.dimensions %}<div><dt>Maße</dt><dd>{{ product.dimensions }}</dd></div>{% endif %}
        <div><dt>Material</dt><dd>PLA</dd></div>
        <div><dt>Verfahren</dt><dd>FDM-3D-Druck</dd></div>
        <div><dt>Farbe</dt><dd>{{ variants.length }} Varianten</dd></div>
        <div><dt>Artikelnummer</dt><dd>{{ product.sku or '–' }}</dd></div>
        <div><dt>Herstellung</dt><dd>Deutschland</dd></div>
      </dl>
      <p class="text-muted"><small>Hinweis: Das Gewicht aus der alten Produktseite („0,70 g“) ist offensichtlich fehlerhaft und wird hier bewusst nicht angegeben.</small></p>
    </aside>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="shop-note-grid">
      <div class="card">
        <h2>Versand</h2>
        <ul class="check-list">
          {% for method in productShippingMethods %}
            <li><strong>{{ method.label }}</strong> · {{ method.deliveryDays }}{% if method.price > 0 %} · {{ method.price | euro }}{% else %} · kostenlos{% endif %}</li>
          {% endfor %}
        </ul>
      </div>
      <div class="card">
        <h2>Zahlung</h2>
        <ul class="check-list">
          {% for method in publicPaymentMethods %}
            <li><strong>{{ method.label }}</strong><br><span class="text-muted">{{ method.note }}</span></li>
          {% endfor %}
        </ul>
      </div>
      <div class="card">
        <h2>Rechtliches</h2>
        <ul class="link-list">
          <li><a href="/agb/">Allgemeine Geschäftsbedingungen</a></li>
          <li><a href="/widerruf/">Widerrufsbelehrung</a></li>
          <li><a href="/versand/">Versandarten</a></li>
          <li><a href="/zahlung/">Zahlungsarten</a></li>
          <li><a href="/datenschutz/">Datenschutz</a></li>
        </ul>
      </div>
    </div>
  </div>
</section>
{% endblock %}
