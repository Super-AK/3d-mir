{% extends "layouts/base.njk" %}

{% block title %}Bestellung – 3D-MIR{% endblock %}
{% block description %}Ihre Bestellung bei 3D-MIR.{% endblock %}
{% block robots %}noindex,nofollow{% endblock %}

{% block content %}
<section class="page-head">
  <div class="container">
    <nav class="breadcrumb" aria-label="Brotkrumen">
      <ol><li><a href="/">Start</a></li><li><a href="/shop/">Shop</a></li><li aria-current="page">Bestellung</li></ol>
    </nav>
    {% if not number %}
      <h1>Bestellung</h1>
      <p>Die Bestellung konnte nicht gefunden werden. Bitte prüfen Sie den Link aus Ihrer Bestätigungs-E-Mail.</p>
    {% elif order and order.payment_status == 'bezahlt' %}
      <h1>Zahlung eingegangen</h1>
      <p>Ihre Bestellung <strong>{{ number }}</strong> ist bezahlt. Vielen Dank!</p>
    {% elif order and order.payment_status == 'fehlgeschlagen' %}
      <h1>Zahlung nicht abgeschlossen</h1>
      <p>Ihre Bestellung <strong>{{ number }}</strong> ist gespeichert, die Zahlung wurde aber nicht abgeschlossen.</p>
    {% elif order and order.payment_status == 'in_bearbeitung' %}
      <h1>Zahlung wird bearbeitet</h1>
      <p>Ihre Bestellung <strong>{{ number }}</strong> ist bei uns eingegangen. Wir warten auf die Zahlungsbestätigung.</p>
    {% else %}
      <h1>Vielen Dank für Ihre Bestellung</h1>
      <p>Ihre Bestellung <strong>{{ number }}</strong> ist bei uns eingegangen.</p>
    {% endif %}
  </div>
</section>

<section class="section">
  <div class="container order-layout">
    {% if order %}
      <div class="card order-card">
        <p><span class="badge badge-{{ paymentStatusTone }}">{{ paymentStatusText }}</span></p>

        {% if order.payment_status == 'bezahlt' %}
          <h2>Wie geht es weiter?</h2>
          <ol class="order-steps">
            <li><strong>Zahlung:</strong> Ihre Zahlung ist bei uns eingegangen.</li>
            <li><strong>Fertigung:</strong> Wir drucken und verpacken Ihre Bestellung.</li>
            <li><strong>Versand:</strong> Sie erhalten eine Nachricht, sobald das Paket unterwegs ist.</li>
          </ol>

        {% elif order.payment_status == 'fehlgeschlagen' %}
          <h2>Zahlung erneut starten</h2>
          <p>Die Zahlung wurde nicht abgeschlossen. Ihre Bestellung bleibt gespeichert. Sie können die Zahlung erneut starten oder uns kontaktieren.</p>
          {% if order.status == 'storniert' or order.stock_released_at %}
            <p class="text-muted">Diese Bestellung ist nicht mehr aktiv. Bitte legen Sie die Artikel erneut in den Warenkorb.</p>
          {% elif retryUrl %}
            <p><a class="btn" href="{{ retryUrl }}">Zahlung erneut starten</a></p>
          {% endif %}

        {% elif order.payment_status == 'in_bearbeitung' %}
          <h2>Zahlung noch nicht abgeschlossen</h2>
          <p>Die Zahlung wurde noch nicht bestätigt. Starten Sie die Zahlung erneut oder aktualisieren Sie den Status, wenn Sie bereits bezahlt haben.</p>
          {% if order.status == 'storniert' or order.stock_released_at %}
            <p class="text-muted">Diese Bestellung ist nicht mehr aktiv. Bitte legen Sie die Artikel erneut in den Warenkorb.</p>
          {% else %}
            <div class="form-actions">
              {% if retryUrl %}<a class="btn" href="{{ retryUrl }}">Jetzt bezahlen</a>{% endif %}
              <a class="btn btn-secondary" href="{{ refreshUrl }}">Status aktualisieren</a>
            </div>
          {% endif %}

        {% elif paymentMethod and paymentMethod.provider == 'stripe' %}
          <h2>Zahlung abschließen</h2>
          <p>Ihre Bestellung ist gespeichert, die Zahlung ist aber noch offen. Sie können die Zahlung jetzt starten.</p>
          {% if order.status == 'storniert' or order.stock_released_at %}
            <p class="text-muted">Diese Bestellung ist nicht mehr aktiv. Bitte legen Sie die Artikel erneut in den Warenkorb.</p>
          {% elif retryUrl %}
            <div class="form-actions">
              <a class="btn" href="{{ retryUrl }}">Jetzt bezahlen</a>
              <a class="btn btn-secondary" href="{{ refreshUrl }}">Status aktualisieren</a>
            </div>
          {% endif %}

        {% elif paymentMethod and paymentMethod.provider == 'manual' %}
          <h2>Zahlung per Vorkasse</h2>
          <p>Bitte überweisen Sie den Gesamtbetrag von <strong>{{ order.total_cents | price }}</strong> auf unser Konto. Die vollständige Bankverbindung und der Verwendungszweck stehen in der Bestätigungs-E-Mail, die wir Ihnen soeben gesendet haben.</p>
          <p class="text-muted">Aus Sicherheitsgründen zeigen wir die Kontodaten nicht auf dieser Seite an. Falls Sie die E-Mail nicht erhalten haben, prüfen Sie bitte Ihren Spam-Ordner oder kontaktieren Sie uns.</p>
          <p>Die Bestellung wird nach Zahlungseingang gefertigt bzw. versandt.</p>

        {% else %}
          <h2>Wie geht es weiter?</h2>
          <ol class="order-steps">
            <li><strong>Prüfung:</strong> Wir prüfen Ihre Angaben und die Verfügbarkeit der gewünschten Farbe.</li>
            <li><strong>Zahlung:</strong> Sie erhalten von uns eine E-Mail mit den Zahlungsdetails.</li>
            <li><strong>Fertigung:</strong> Nach Zahlungseingang drucken und verpacken wir Ihre Bestellung.</li>
            <li><strong>Versand:</strong> Sie erhalten eine Nachricht, sobald das Paket unterwegs ist.</li>
          </ol>
        {% endif %}

        <p class="mt-2">Bei Fragen antworten Sie einfach auf die Bestätigungs-E-Mail oder nutzen Sie unser <a href="/kontakt/">Kontaktformular</a>.</p>
      </div>

      <aside class="cart-summary card">
        <h2>Ihre Positionen</h2>
        <ul class="summary-items">
          {% for item in items %}
            <li>
              <span><strong>{{ item.quantity }} ×</strong> {{ item.name }}<br><span class="text-muted">{{ item.variant }}</span></span>
              <span>{{ item.line_total_cents | price }}</span>
            </li>
          {% endfor %}
        </ul>
        <dl class="summary-list">
          <div><dt>Zwischensumme</dt><dd>{{ order.subtotal_cents | price }}</dd></div>
          <div><dt>Versand</dt><dd>{{ order.shipping_cents | price }}</dd></div>
          {% for option in options %}
            <div><dt>{{ option.label }}</dt><dd>{{ option.price_cents | price }}</dd></div>
          {% endfor %}
          <div><dt>Zahlungsart</dt><dd>{{ paymentMethod.label if paymentMethod else order.payment_method }}</dd></div>
        </dl>
        <p class="summary-total"><span>Gesamt</span><strong>{{ order.total_cents | price }}</strong></p>
        <p class="text-muted"><small>{{ site.business.vatNote }}</small></p>
      </aside>
    {% endif %}
  </div>

  <div class="container mt-2">
    <div class="hero-actions">
      <a class="btn" href="/shop/">Weiter im Shop</a>
      <a class="btn btn-secondary" href="/">Zur Startseite</a>
    </div>
  </div>
</section>
{% endblock %}
