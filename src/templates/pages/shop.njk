{% extends "layouts/base.njk" %}

{% block title %}Shop – fertige 3D-Druck-Produkte | 3D-MIR{% endblock %}
{% block description %}Fertige 3D-Druck-Produkte aus eigener Fertigung: Recycling-Box für Batterien in Wunschfarbe. Weitere Produkte und individuelle Anfertigungen auf Anfrage.{% endblock %}
{% block ogtitle %}Shop – 3D-MIR{% endblock %}

{% block content %}
<section class="page-head">
  <div class="container">
    <nav class="breadcrumb" aria-label="Brotkrumen">
      <ol><li><a href="/">Start</a></li><li aria-current="page">Shop</li></ol>
    </nav>
    <h1>Shop</h1>
    <p>Fertige 3D-Druck-Produkte aus eigener Fertigung – in kleinen Stückzahlen gedruckt, geprüft und in Wunschfarbe geliefert.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    {% if publication.shopStatus == 'PLATZHALTER' %}
      <div class="alert alert-warning" role="status">
        <p><strong>Hinweis:</strong> {{ shopConfig.notice }}</p>
      </div>
    {% endif %}

    <div class="shop-intro">
      <div>
        <p class="eyebrow">Aus eigener Fertigung</p>
        <h2>Kleine Serie, große Sorgfalt</h2>
        <p>Jedes Teil wird im FDM-Verfahren gedruckt und von Hand nachgearbeitet. Farben und Stückzahlen können je nach Verfügbarkeit abweichen – bei Fragen einfach melden.</p>
      </div>
      <div class="shop-intro-facts">
        <div><strong>Versand</strong><span>{% if shippingFromPrice is not null %}ab {{ shippingFromPrice | euro }}{% else %}kostenlos{% endif %}{% if pricing.shipping.freeShippingFrom > 0 %} · frei ab {{ pricing.shipping.freeShippingFrom | euro }}{% endif %}</span></div>
        <div><strong>Fertigung</strong><span>in Schömberg, Deutschland</span></div>
        <div><strong>Fragen</strong><span><a href="/kontakt/">Persönlich erreichbar</a></span></div>
      </div>
    </div>

    {% if categories.length > 0 %}
      <nav class="shop-categories" aria-label="Produktkategorien">
        <a href="/shop/" class="badge {% if not activeCategory %}badge-info{% else %}badge-neutral{% endif %}">Alle</a>
        {% for category in categories %}
          <a href="/shop/?kategorie={{ category.slug }}" class="badge {% if activeCategory and activeCategory.id == category.id %}badge-info{% else %}badge-neutral{% endif %}">{{ category.name }}</a>
        {% endfor %}
      </nav>
    {% endif %}

    <div class="product-grid">
      {% for product in products %}
        <article class="product-card card card-hover">
          <a class="product-card-media" href="/shop/{{ product.slug }}/" tabindex="-1" aria-hidden="true">
            {% if product.image %}
              {{ image(product.image, { sizes: '(max-width: 700px) 100vw, 33vw', alt: product.name }) | safe }}
            {% else %}
              <span class="product-card-placeholder">3D-MIR</span>
            {% endif %}
          </a>
          <div class="product-card-body">
            <p class="eyebrow">{{ product.categoryName }}</p>
            <h2><a href="/shop/{{ product.slug }}/">{{ product.name }}</a></h2>
            <p>{{ product.short_description }}</p>
            <div class="product-card-footer">
              <p class="product-price">{{ product.priceLabel }}</p>
              <a class="btn btn-secondary btn-small" href="/shop/{{ product.slug }}/">Details ansehen</a>
            </div>
          </div>
        </article>
      {% else %}
        <p>Derzeit sind keine Produkte verfügbar. Individuelle Anfertigungen sind über den <a href="/3d-druck-rechner/">Rechner</a> möglich.</p>
      {% endfor %}
    </div>

    <div class="shop-note-grid mt-2">
      <div class="card">
        <h2>Versand &amp; Abholung</h2>
        <ul class="check-list">
          {% for method in pricing.shipping.methods %}
            <li><strong>{{ method.label }}</strong> · {{ method.deliveryDays }}{% if method.price > 0 %} · {{ method.price | euro }}{% else %} · kostenlos{% endif %}{% if method.note %}<br><span class="text-muted">{{ method.note }}</span>{% endif %}</li>
          {% endfor %}
        </ul>
        {% if pricing.shipping.freeShippingFrom > 0 %}
          <p class="text-muted"><small>Ab {{ pricing.shipping.freeShippingFrom | euro }} Warenwert entfallen die Versandkosten für den Paketversand.</small></p>
        {% endif %}
      </div>
      <div class="card">
        <h2>Zahlung</h2>
        <ul class="check-list">
          {% for method in publicPaymentMethods %}
            <li><strong>{{ method.label }}</strong><br><span class="text-muted">{{ method.note }}</span></li>
          {% endfor %}
        </ul>
        <p class="text-muted"><small>{{ site.business.vatNote }}</small></p>
      </div>
      <div class="card card-highlight">
        <h2>Etwas Eigenes?</h2>
        <p>Sie brauchen ein individuelles Bauteil, ein Ersatzteil oder eine Kleinserie? Laden Sie Ihr Modell im Rechner hoch und erhalten Sie eine erste Preisschätzung.</p>
        <p><a class="btn btn-small" href="/3d-druck-rechner/">Zum 3D-Druck-Rechner</a></p>
      </div>
    </div>
  </div>
</section>
{% endblock %}
