{% extends "layouts/base.njk" %}

{% block title %}{{ site.seo.defaultTitle }}{% endblock %}
{% block description %}{{ site.seo.defaultDescription }}{% endblock %}

{% block head %}
<script type="application/ld+json">
{{ localBusinessJsonLd | jsonld | safe }}
</script>
{% endblock %}

{% block content %}
<section class="hero">
  <div class="container hero-grid">
    <div>
      <p class="eyebrow">{{ content['home.hero.kicker'] }}</p>
      <h1>{{ content['home.hero.title'] }}</h1>
      <p class="hero-lead">{{ content['home.hero.text'] }}</p>
      <div class="hero-actions">
        <a class="btn" href="/3d-druck-rechner/">
          Preis berechnen
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a class="btn btn-secondary" href="/shop/">Zum Shop</a>
      </div>
      <div class="hero-meta">
        <div><strong>FDM-Druck</strong><span>PLA · PETG · ABS · ASA</span></div>
        <div><strong>Ab 1 Stück</strong><span>Einzelteile &amp; Kleinserien</span></div>
        <div><strong>Aus Schömberg</strong><span>Fertigung in Deutschland</span></div>
      </div>
    </div>
    <div class="hero-visual">
      {{ image(site.images.hero or 'hero', { sizes: '(max-width: 860px) 100vw, 46vw', priority: true, alt: 'FDM-3D-Drucker bei der Fertigung eines Bauteils' }) | safe }}
      <p class="hero-badge">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        Unverbindliche Preisschätzung in Minuten
      </p>
    </div>
  </div>
</section>

<div class="trust-strip">
  <div class="container trust-grid">
    <p><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg> Fertigung in Deutschland</p>
    <p><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg> Rückmeldung in der Regel binnen 24 h</p>
    <p><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 7 9 18l-5-5"/></svg> Persönliche Materialberatung</p>
    <p><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 7h13v10H3zM16 10h3l2 3v4h-5z"/><circle cx="7" cy="18" r="1.5"/><circle cx="18" cy="18" r="1.5"/></svg> Versand mit Sendungsverfolgung</p>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Leistungen</p>
      <h2>Vom Prototyp bis zum Ersatzteil</h2>
      <p>Wir drucken Ihre Modelle im FDM-Verfahren – präzise, robust und in der Stückzahl, die Sie brauchen.</p>
    </div>
    <div class="grid grid-4">
      {% for item in services %}
        <article class="card card-hover">
          <span class="card-icon" aria-hidden="true">{{ item.icon | safe }}</span>
          <h3>{{ item.title }}</h3>
          <p>{{ item.text }}</p>
        </article>
      {% endfor %}
    </div>
    <p class="mt-2"><a href="/leistungen/">Alle Leistungen und Materialien ansehen →</a></p>
  </div>
</section>

<section class="section section-soft">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">So funktioniert es</p>
      <h2>In vier Schritten zum fertigen Druck</h2>
    </div>
    <ol class="steps">
      <li class="step"><h3>Modell hochladen</h3><p>STL, 3MF oder OBJ – direkt im Rechner, inklusive 3D-Vorschau.</p></li>
      <li class="step"><h3>Konfigurieren</h3><p>Material, Farbe, Füllung und Stückzahl wählen – der Preis aktualisiert sich live.</p></li>
      <li class="step"><h3>Angebot erhalten</h3><p>Wir prüfen das Modell und melden uns mit einem verbindlichen Angebot.</p></li>
      <li class="step"><h3>Druck &amp; Versand</h3><p>Nach Freigabe produzieren wir und versenden sicher verpackt.</p></li>
    </ol>
  </div>
</section>

<section class="section">
  <div class="container split">
    <div>
      <p class="eyebrow">Materialien</p>
      <h2>Das richtige Material für Ihren Einsatz</h2>
      <p class="text-muted">Ob feine Details, hohe Temperaturen oder UV-Beständigkeit: Wir beraten Sie zur passenden Kunststoffwahl – und drucken nur, was zu Ihrem Bauteil passt.</p>
      <div class="material-grid material-grid-2">
        {% for material in pricing.materials | slice(0, 4) %}
          <article class="material-card">
            <h3>{{ material.label }} <span class="badge badge-neutral">bis {{ material.maxTempC }} °C</span></h3>
            <p class="text-muted">{{ material.useCases }}</p>
          </article>
        {% endfor %}
      </div>
      <p class="mt-2"><a class="btn btn-secondary" href="/leistungen/#materialien">Materialien vergleichen</a></p>
    </div>
    {% if galleryImages | length > 0 %}
      <div class="gallery-teaser">
        {% for name in (galleryImages | slice(0, 4)) %}
          {{ image(name, { sizes: '(max-width: 860px) 50vw, 22vw', alt: '3D-gedrucktes Bauteil aus der Werkstatt' }) | safe }}
        {% endfor %}
      </div>
    {% endif %}
    </div>
  </div>
</section>

{% if galleryImages | length > 0 %}
<section class="section section-soft">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Referenzen</p>
      <h2>Einblick in die Werkstatt</h2>
      <p>Echte Drucke aus laufenden Projekten – von filigranen Modellen bis zu funktionalen Bauteilen.</p>
    </div>
    <div class="gallery">
      {% for name in galleryImages %}
        <figure class="gallery-item">
          {{ image(name, { sizes: '(max-width: 620px) 50vw, (max-width: 1024px) 33vw, 24vw', alt: '3D-gedrucktes Bauteil aus eigener Fertigung' }) | safe }}
        </figure>
      {% endfor %}
    </div>
    <p class="text-muted mt-2"><small>Weitere Referenzen und aktuelle Arbeiten finden Sie in unserem <a href="{{ site.channels.etsy.url }}" target="_blank" rel="noopener">Etsy-Shop</a>. Fotos eigener Drucke werden laufend ergänzt.</small></p>
  </div>
</section>
{% endif %}

<section class="section">
  <div class="container">
    <div class="split">
      <div>
        <p class="eyebrow">Warum 3D-MIR</p>
        <h2>Handwerk, das man sieht</h2>
        <p class="text-muted">Kein anonymes Druckzentrum: Sie sprechen direkt mit der Person, die Ihr Bauteil vorbereitet und druckt. Das bedeutet kurze Wege, ehrliche Einschätzungen und eine sorgfältige Nacharbeit.</p>
        <ul class="check-list">
          <li><strong>Persönlich:</strong> direkte Abstimmung per E-Mail oder Telefon.</li>
          <li><strong>Transparent:</strong> nachvollziehbare Kalkulation, keine versteckten Posten.</li>
          <li><strong>Sorgfältig:</strong> Prüfung von Modell und Maßhaltigkeit vor dem Druck.</li>
          <li><strong>Regional:</strong> gefertigt in Schömberg, versendet aus Deutschland.</li>
        </ul>
      </div>
      <div>
        {{ image(site.images.service or 'service', { sizes: '(max-width: 860px) 100vw, 45vw', alt: 'Bauteile aus dem 3D-Druck-Service' }) | safe }}
      </div>
    </div>
  </div>
</section>

<section class="section section-soft">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Häufige Fragen</p>
      <h2>Gut zu wissen</h2>
    </div>
    <div class="faq">
      <details>
        <summary>Welche Dateiformate kann ich hochladen?</summary>
        <div>STL, 3MF und OBJ – direkt im Rechner mit 3D-Vorschau. STEP-Dateien können Sie uns für eine Angebotsanfrage per E-Mail senden; eine Vorschau ist dafür nicht verfügbar.</div>
      </details>
      <details>
        <summary>Wie genau ist der Preis im Rechner?</summary>
        <div>Der Rechner liefert eine <strong>unverbindliche Schätzung</strong> auf Basis von Volumen, Material, Füllung und Stückzahl. Den verbindlichen Preis nennen wir nach Prüfung des Modells im Angebot.</div>
      </details>
      <details>
        <summary>Wie lange dauert die Fertigung?</summary>
        <div>Kleine Teile sind meist in 1–3 Werktagen fertig, größere Modelle dauern länger. Nach Eingang Ihres Modells nennen wir Ihnen einen konkreten Termin. Der Versand kommt je nach Versandart hinzu.</div>
      </details>
      <details>
        <summary>Kann ich auch nur ein einzelnes Teil bestellen?</summary>
        <div>Ja. Wir fertigen ab einem Stück. Bei mehreren gleichen Teilen greift eine Mengenstaffel.</div>
      </details>
      <details>
        <summary>Darf ich fremde Modelle drucken lassen?</summary>
        <div>Nur, wenn Sie die erforderlichen Nutzungsrechte besitzen. Mit der Anfrage bestätigen Sie, dass Sie zur Nutzung des Modells berechtigt sind.</div>
      </details>
      <details>
        <summary>Welche Farben sind möglich?</summary>
        <div>Die verfügbaren Farben hängen vom Material ab und werden im Rechner angezeigt. Sonderfarben sind auf Anfrage möglich.</div>
      </details>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="cta">
      <div>
        <h2>{{ content['home.contact.title'] }}</h2>
        <p>{{ content['home.contact.text'] }}</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-light" href="/kontakt/">Kontakt aufnehmen</a>
        <a class="btn btn-ghost-light" href="/3d-druck-rechner/">Modell hochladen</a>
      </div>
    </div>
  </div>
</section>
{% endblock %}
