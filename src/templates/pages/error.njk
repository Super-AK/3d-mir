{% extends "layouts/base.njk" %}

{% block title %}{{ title }} – {{ site.business.name }}{% endblock %}
{% block robots %}noindex,follow{% endblock %}

{% block content %}
<section class="section">
  <div class="container">
    <p class="eyebrow">Fehler {{ statusCode }}</p>
    <h1>{{ title }}</h1>
    <p class="text-muted">{{ message }}</p>
    <p class="mt-2"><a class="btn" href="/">Zur Startseite</a></p>
  </div>
</section>
{% endblock %}
