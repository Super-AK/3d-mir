{% extends "layouts/base.njk" %}

{% block title %}3D-Druck-Rechner – Preis schätzen und Angebot anfragen | 3D-MIR{% endblock %}
{% block description %}Modell hochladen, Material und Stückzahl wählen und sofort eine unverbindliche Preisschätzung erhalten. STL, 3MF und OBJ mit 3D-Vorschau – ohne Registrierung.{% endblock %}
{% block ogtitle %}3D-Druck-Rechner – Preis schätzen | 3D-MIR{% endblock %}

{% block content %}
<section class="page-head">
  <div class="container">
    <nav class="breadcrumb" aria-label="Brotkrumen">
      <ol><li><a href="/">Start</a></li><li aria-current="page">3D-Druck-Rechner</li></ol>
    </nav>
    <h1>3D-Druck-Rechner</h1>
    <p>Modell hochladen, konfigurieren und in wenigen Sekunden eine unverbindliche Preisschätzung erhalten. Anschließend können Sie direkt ein Angebot anfragen.</p>
  </div>
</section>

<section class="section">
  <div class="container calculator-layout" data-calculator data-config="{{ calculatorConfig | json }}" data-max-upload-mb="{{ maxUploadMb }}">
    <noscript>
      <div class="alert alert-warning">
        <p>Der Rechner benötigt JavaScript für die 3D-Vorschau und die Preisschätzung. Sie können uns Ihr Modell alternativ per E-Mail an <a href="mailto:{{ site.business.email }}">{{ site.business.email }}</a> senden.</p>
      </div>
    </noscript>

    <form id="calc-form" class="calculator-form" method="post" action="/3d-druck-rechner/anfrage/" enctype="multipart/form-data" novalidate>
      <section class="calc-panel" aria-labelledby="calc-step-1">
        <h2 id="calc-step-1"><span class="step-number">1</span> Modell hochladen</h2>
        <div class="dropzone" data-dropzone>
          <input id="model" name="model" type="file" accept=".stl,.3mf,.obj,model/stl,model/obj,model/3mf" required>
          <label for="model">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 16V4m0 0L7 9m5-5 5 5"/><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg>
            <strong>Datei auswählen oder hierher ziehen</strong>
            <span>STL, 3MF oder OBJ · maximal {{ maxUploadMb }} MB</span>
          </label>
        </div>
        <p class="file-meta" data-file-meta hidden></p>
        <p class="hint">Ihre Datei wird nur zur Analyse und – bei einer Anfrage – zur Angebotserstellung gespeichert. Bitte laden Sie keine vertraulichen Konstruktionsdaten hoch, wenn Sie deren Weitergabe nicht wünschen.</p>

        <div class="preview-wrap">
          <canvas id="model-preview" class="model-preview" width="720" height="420" aria-label="3D-Vorschau des hochgeladenen Modells"></canvas>
          <p class="preview-empty" data-preview-empty>Nach dem Upload erscheint hier eine 3D-Vorschau.</p>
          <p class="preview-status" data-preview-status role="status" aria-live="polite"></p>
        </div>

        <dl class="metrics" data-metrics hidden>
          <div><dt>Maße (B × T × H)</dt><dd data-metric-dimensions>–</dd></div>
          <div><dt>Volumen</dt><dd data-metric-volume>–</dd></div>
          <div><dt>Oberfläche</dt><dd data-metric-surface>–</dd></div>
          <div><dt>Dreiecke</dt><dd data-metric-triangles>–</dd></div>
        </dl>
      </section>

      <section class="calc-panel" aria-labelledby="calc-step-2">
        <h2 id="calc-step-2"><span class="step-number">2</span> Druck konfigurieren</h2>
        <div class="form-row">
          <div class="field">
            <label for="materialId">Material</label>
            <select id="materialId" name="materialId">
              {% for material in pricing.materials %}
                <option value="{{ material.id }}">{{ material.label }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="field">
            <label for="printerId">Drucker</label>
            <select id="printerId" name="printerId">
              {% for printer in pricing.printers %}
                <option value="{{ printer.id }}">{{ printer.label }}</option>
              {% endfor %}
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="color">Farbe</label>
            <select id="color" name="color">
              <option value="">Farbe nach Absprache</option>
            </select>
          </div>
          <div class="field">
            <label for="coating">Nachbearbeitung</label>
            <select id="coating" name="coating">
              {% for coating in pricing.coatings %}
                <option value="{{ coating.id }}">{{ coating.label }}{% if coating.pricePerPart > 0 %} (+ {{ coating.pricePerPart | price }}){% endif %}</option>
              {% endfor %}
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="infill">Füllung</label>
            <select id="infill" name="infill">
              {% for value in pricing.infillOptions %}
                <option value="{{ value }}" {% if value == 20 %}selected{% endif %}>{{ value }} %</option>
              {% endfor %}
            </select>
          </div>
          <div class="field">
            <label for="layerHeight">Schichthöhe</label>
            <select id="layerHeight" name="layerHeight">
              {% for value in pricing.layerHeightOptions %}
                <option value="{{ value }}" {% if value == 0.2 %}selected{% endif %}>{{ value | number(2) }} mm</option>
              {% endfor %}
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="quantity">Stückzahl</label>
            <input id="quantity" name="quantity" type="number" min="1" max="500" step="1" value="1" inputmode="numeric">
            <span class="hint">Staffelpreise ab 3, 5, 10 und 25 Stück.</span>
          </div>
          <div class="field">
            <label for="scalePercent">Skalierung</label>
            <div class="input-suffix">
              <input id="scalePercent" name="scalePercent" type="number" min="10" max="400" step="1" value="100" inputmode="decimal">
              <span>%</span>
            </div>
          </div>
        </div>
        <div class="field field-inline">
          <label for="unit">Einheit der Anzeige</label>
          <select id="unit" name="unit">
            <option value="mm">Millimeter (mm)</option>
            <option value="inch">Zoll (inch)</option>
          </select>
        </div>
      </section>

      <section class="calc-panel" aria-labelledby="calc-step-3">
        <h2 id="calc-step-3"><span class="step-number">3</span> Angebot anfragen</h2>
        <p class="text-muted">Die Preisschätzung ist unverbindlich. Wir prüfen das Modell und senden Ihnen ein verbindliches Angebot.</p>
        <div class="form-row">
          <div class="field">
            <label for="name">Name <span aria-hidden="true">*</span></label>
            <input id="name" name="name" type="text" autocomplete="name" required maxlength="120">
          </div>
          <div class="field">
            <label for="email">E-Mail <span aria-hidden="true">*</span></label>
            <input id="email" name="email" type="email" autocomplete="email" required maxlength="200">
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="phone">Telefon <span class="hint">(optional)</span></label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="60">
          </div>
          <div class="field">
            <label for="company">Firma <span class="hint">(optional)</span></label>
            <input id="company" name="company" type="text" autocomplete="organization" maxlength="160">
          </div>
        </div>
        <div class="field">
          <label for="message">Anmerkungen <span class="hint">(optional)</span></label>
          <textarea id="message" name="message" maxlength="3000" placeholder="Besondere Anforderungen, Einsatzbereich, Terminwunsch …"></textarea>
        </div>

        <div class="honeypot" aria-hidden="true">
          <label for="website-calc">Website</label>
          <input id="website-calc" name="website" type="text" tabindex="-1" autocomplete="off">
        </div>

        <label class="checkbox">
          <input type="checkbox" name="consent" value="1" required>
          <span>Ich habe die <a href="/datenschutz/">Datenschutzerklärung</a> gelesen und bin mit der Verarbeitung meiner Angaben und der hochgeladenen Datei zur Bearbeitung der Anfrage einverstanden. <span aria-hidden="true">*</span></span>
        </label>

        <p class="form-error" data-form-error role="alert" hidden></p>
        <p class="hint">Pflichtfelder sind mit * markiert. Bei individuell gefertigten Teilen gelten die Hinweise zum <a href="/widerruf/">Widerrufsrecht</a>.</p>
      </section>
    </form>

    <aside class="calculator-aside">
      <div class="price-box" data-price-box>
        <p class="eyebrow">Unverbindliche Schätzung</p>
        <p class="price-total" data-price>–</p>
        <p class="price-sub" data-price-sub>Modell hochladen, um den Preis zu berechnen.</p>
        <ul class="price-breakdown" data-breakdown></ul>
        <dl class="price-meta">
          <div><dt>Gewicht</dt><dd data-weight>–</dd></div>
          <div><dt>Druckzeit</dt><dd data-hours>–</dd></div>
        </dl>
        <div class="warnings" data-warnings hidden></div>
        <button type="submit" form="calc-form" class="btn btn-block" data-submit disabled>Unverbindliches Angebot anfragen</button>
        <p class="hint">{{ pricing.meta.estimateDisclaimer }}</p>
      </div>

      <div class="card">
        <h2>So läuft es ab</h2>
        <ol class="compact-steps">
          <li>Modell und Einstellungen prüfen</li>
          <li>Anfrage mit Ihrer Datei absenden</li>
          <li>Verbindliches Angebot per E-Mail erhalten</li>
          <li>Nach Freigabe drucken wir und versenden</li>
        </ol>
        <p class="text-muted"><small>Ihre Datei wird nur für diese Anfrage gespeichert und nicht veröffentlicht.</small></p>
      </div>

      <div class="card card-highlight">
        <h2>Fragen zur Datei?</h2>
        <p class="text-muted">Sie sind unsicher, ob Ihr Modell druckbar ist? Schreiben Sie uns – wir prüfen es vorab.</p>
        <p><a class="btn btn-secondary btn-block" href="/kontakt/">Kontakt aufnehmen</a></p>
      </div>

      <div class="calc-image">
        {{ image('calculator', { sizes: '(max-width: 900px) 100vw, 28vw', alt: '3D-Drucker mit Modell im Bauraum' }) | safe }}
      </div>
    </aside>
  </div>
</section>
{% endblock %}

{% block scripts %}
<script type="module" src="{{ asset('ts/calculator.ts') }}"></script>
{% endblock %}
