{% extends "layouts/account.njk" %}
{% import "account/partials/status.njk" as status %}

{% block title %}Mein Konto – 3D-MIR{% endblock %}
{% block accountTitle %}Hallo {{ customer.first_name or customer.email }}{% endblock %}
{% block accountSubtitle %}Ihre Bestellungen, Rechnungen und Daten.{% endblock %}

{% block accountContent %}
  <div class="account-stats">
    <div class="account-stat"><span class="account-stat-label">Offene Bestellungen</span><strong>{{ stats.openOrders }}</strong></div>
    <div class="account-stat"><span class="account-stat-label">Gesamtbestellungen</span><strong>{{ stats.totalOrders }}</strong></div>
    <div class="account-stat"><span class="account-stat-label">Angebotsanfragen</span><strong>{{ stats.quotes }}</strong></div>
  </div>

  <section class="account-card">
    <div class="account-card-head"><h2 class="account-card-title">Ihre Kundennummer</h2></div>
    <dl class="account-dl">
      <dt>Kundennummer</dt><dd><code>{{ customer.customer_no }}</code></dd>
      <dt>Faktura-Kundennummer</dt><dd>{% if customer.faktura_customer_no %}<code>{{ customer.faktura_customer_no }}</code>{% else %}Noch keine Zuordnung{% endif %}</dd>
      <dt>E-Mail</dt><dd>{{ customer.email }}</dd>
      <dt>E-Mail bestätigt</dt><dd>{% if customer.email_verified_at %}<span class="account-badge account-badge--success">Ja</span>{% else %}<span class="account-badge account-badge--neutral">Nein</span>{% endif %}</dd>
      <dt>Status</dt><dd>{% if customer.status == 'active' %}<span class="account-badge account-badge--success">Aktiv</span>{% else %}<span class="account-badge account-badge--neutral">{{ customer.status }}</span>{% endif %}</dd>
    </dl>
  </section>

  <section class="account-card">
    <div class="account-card-head">
      <h2 class="account-card-title">Letzte Bestellungen</h2>
      <a href="/konto/bestellungen/">Alle ansehen</a>
    </div>
    <div class="account-table-wrap">
      <table class="account-table">
        <thead><tr><th>Nummer</th><th>Datum</th><th>Status</th><th class="is-number">Betrag</th></tr></thead>
        <tbody>
          {% for order in orders %}
            <tr>
              <td><a href="/konto/rechnung/{{ order.id }}/">{{ order.order_number }}</a></td>
              <td>{{ order.created_at | date }}</td>
              <td>{{ status.badge(order.status) }}</td>
              <td class="is-number">{{ order.total_cents | price }}</td>
            </tr>
          {% else %}
            <tr><td colspan="4">Noch keine Bestellungen.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
{% endblock %}
