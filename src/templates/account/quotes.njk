{% extends "layouts/account.njk" %}

{% block title %}Angebotsanfragen – 3D-MIR{% endblock %}
{% block accountTitle %}Ihre Angebotsanfragen{% endblock %}
{% block accountSubtitle %}Anfragen aus dem 3D-Druck-Rechner mit Ihrer E-Mail-Adresse.{% endblock %}

{% block accountContent %}
  <section class="account-card">
    <div class="account-card-head"><h2 class="account-card-title">Anfragen</h2></div>
    <div class="account-table-wrap">
      <table class="account-table">
        <thead><tr><th>Datum</th><th>Status</th><th>Name</th></tr></thead>
        <tbody>
          {% for quote in quotes %}
            <tr><td>{{ quote.created_at | date }}</td><td>{{ quote.status }}</td><td>{{ quote.name or '–' }}</td></tr>
          {% else %}
            <tr><td colspan="3">Keine Anfragen mit dieser E-Mail-Adresse gefunden.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
{% endblock %}
