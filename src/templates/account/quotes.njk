{% extends "layouts/account.njk" %}

{% block title %}Angebotsanfragen – 3D-MIR{% endblock %}
{% block accountContent %}
  <div class="admin-page-head"><div><h1>Ihre Angebotsanfragen</h1></div></div>
  <section class="card admin-panel">
    <div class="table-wrap">
      <table class="admin-edit-table">
        <thead><tr><th>Datum</th><th>Status</th><th>Betreff</th></tr></thead>
        <tbody>
          {% for quote in quotes %}
            <tr><td>{{ quote.created_at | date }}</td><td>{{ quote.status }}</td><td>{{ quote.name or quote.email }}</td></tr>
          {% else %}
            <tr><td colspan="3" class="text-muted">Keine Anfragen mit dieser E-Mail-Adresse gefunden.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
{% endblock %}
