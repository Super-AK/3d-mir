{% extends "layouts/account.njk" %}

{% block title %}Rechnung – 3D-MIR{% endblock %}
{% block accountTitle %}Rechnung zu {{ order.order_number }}{% endblock %}
{% block accountSubtitle %}Rechnungsdaten aus der Faktura-App.{% endblock %}

{% block accountContent %}
  <section class="account-card">
    <div class="account-card-head"><h2 class="account-card-title">Details</h2></div>
    <dl class="account-dl">
      <dt>Rechnungsnummer</dt><dd><code>{{ order.invoice_number or 'Noch nicht gemeldet' }}</code></dd>
      <dt>Rechnungsdatum</dt><dd>{{ order.invoice_date or '–' }}</dd>
      <dt>Lieferschein</dt><dd><code>{{ order.delivery_note_number or '–' }}</code></dd>
    </dl>
    {% if expired %}
      <p>Link abgelaufen, bitte anfragen.</p>
    {% elif url %}
      <div class="account-form-actions"><a class="btn" href="{{ url }}" target="_blank" rel="noopener">Rechnung öffnen</a></div>
    {% else %}
      <p>Für diese Bestellung liegt noch kein Rechnungslink vor.</p>
    {% endif %}
  </section>
{% endblock %}
