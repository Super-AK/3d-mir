{% extends "layouts/base.njk" %}

{% block content %}
  <div class="admin-shell">
    <aside class="admin-sidebar" id="account-sidebar">
      <nav class="admin-nav" aria-label="Kundenbereich">
        <p class="admin-nav-title">Mein Konto</p>
        <a href="/konto/" {% if currentPath == '/konto/' %}aria-current="page"{% endif %}>Übersicht</a>
        <a href="/konto/bestellungen/" {% if currentPath.startsWith('/konto/bestellungen') %}aria-current="page"{% endif %}>Bestellungen</a>
        <a href="/konto/anfragen/" {% if currentPath.startsWith('/konto/anfragen') %}aria-current="page"{% endif %}>Angebotsanfragen</a>
        <a href="/konto/daten/" {% if currentPath.startsWith('/konto/daten') %}aria-current="page"{% endif %}>Meine Daten</a>
      </nav>
    </aside>
    <main id="admin-inhalt" class="admin-main" tabindex="-1">
      {% block accountContent %}{% endblock %}
    </main>
  </div>
{% endblock %}
