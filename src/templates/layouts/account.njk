{% extends "layouts/base.njk" %}

{% block content %}
  <div class="account-shell">
    <div class="account-head">
      <div>
        <span class="account-eyebrow">Mein Konto</span>
        <h1 class="account-title">{% block accountTitle %}Mein Konto{% endblock %}</h1>
        <p class="account-subtitle">{% block accountSubtitle %}Ihre Bestellungen, Rechnungen und Daten.{% endblock %}</p>
      </div>
      <div class="account-actions">
        <form method="post" action="/konto/abmelden/">
          <button class="btn btn-secondary btn-small" type="submit">Abmelden</button>
        {% include "partials/turnstile.njk" %}
        </form>
      </div>
    </div>

    <nav class="account-tabs" aria-label="Kundenbereich">
      <a class="account-tab {% if currentPath == '/konto/' %}is-active{% endif %}" href="/konto/" {% if currentPath == '/konto/' %}aria-current="page"{% endif %}>Übersicht</a>
      <a class="account-tab {% if currentPath.startsWith('/konto/bestellungen') %}is-active{% endif %}" href="/konto/bestellungen/" {% if currentPath.startsWith('/konto/bestellungen') %}aria-current="page"{% endif %}>Bestellungen</a>
      <a class="account-tab {% if currentPath.startsWith('/konto/anfragen') %}is-active{% endif %}" href="/konto/anfragen/" {% if currentPath.startsWith('/konto/anfragen') %}aria-current="page"{% endif %}>Angebotsanfragen</a>
      <a class="account-tab {% if currentPath.startsWith('/konto/daten') %}is-active{% endif %}" href="/konto/daten/" {% if currentPath.startsWith('/konto/daten') %}aria-current="page"{% endif %}>Meine Daten</a>
    </nav>

    {% block accountContent %}{% endblock %}
  </div>
{% endblock %}
