<!doctype html>
<html lang="de" data-theme="auto">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ site.seo.defaultTitle }}{% endblock %}</title>
  <meta name="description" content="{% block description %}{{ site.seo.defaultDescription }}{% endblock %}">
  <meta name="robots" content="{% block robots %}index,follow{% endblock %}">
  <link rel="canonical" href="{{ site.baseUrl }}{{ currentPath }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.seo.siteName }}">
  <meta property="og:locale" content="de_DE">
  <meta property="og:title" content="{% block ogtitle %}{{ site.seo.defaultTitle }}{% endblock %}">
  <meta property="og:description" content="{% block ogdescription %}{{ site.seo.defaultDescription }}{% endblock %}">
  <meta property="og:url" content="{{ site.baseUrl }}{{ currentPath }}">
  <meta property="og:image" content="{{ site.baseUrl }}/assets/img/og-image.jpg">
  <meta name="theme-color" content="#0a1530">
  {% if site.images.favicon %}
    <link rel="icon" href="{{ faviconUrl }}" type="image/jpeg">
    <link rel="apple-touch-icon" href="{{ faviconUrl }}">
  {% else %}
    <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/assets/img/favicon-32.png" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  {% endif %}
  <link rel="preload" href="/assets/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="manifest" href="/assets/site.webmanifest">
  {% for css in assetCss('ts/main.ts') %}<link rel="stylesheet" href="{{ css }}">{% endfor %}
  {% block head %}{% endblock %}
</head>
<body>
  <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
  {% include "partials/header.njk" %}
  <main id="inhalt" tabindex="-1">
    {% block content %}{% endblock %}
  </main>
  {% include "partials/footer.njk" %}
  <script type="module" src="{{ asset('ts/main.ts') }}"></script>
  {% block scripts %}{% endblock %}
</body>
</html>
