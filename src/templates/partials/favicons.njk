{# Favicon-Links für alle Layouts: ICO für Legacy-Browser, PNG/Touch für Moderne. #}
{% if site.images.favicon %}
  <link rel="icon" href="/favicon.ico?v={{ faviconVersion }}" sizes="16x16 32x32 48x48" type="image/x-icon">
  <link rel="icon" href="/favicon.png?v={{ faviconVersion }}" sizes="180x180" type="image/png">
  <link rel="shortcut icon" href="/favicon.ico?v={{ faviconVersion }}" type="image/x-icon">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v={{ faviconVersion }}" sizes="180x180">
  <link rel="apple-touch-icon-precomposed" href="/apple-touch-icon-precomposed.png?v={{ faviconVersion }}" sizes="180x180">
{% else %}
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml" sizes="any">
  <link rel="icon" href="/favicon.png" sizes="180x180" type="image/png">
  <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
{% endif %}
<link rel="manifest" href="/site.webmanifest?v={{ faviconVersion }}">
